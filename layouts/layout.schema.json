{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dawlings layout, version 1",
  "description": "Machine form of docs/layouts.md section 5. LayoutData.parse implements these rules by hand (a test keeps the two in step); what only the merged room can show (a piece naming its kind, frames resolving, the 64-piece limit, group members) is checked by LayoutSet.resolve. A fragment or variant may carry part of an entry, so the per-entry 'required' lists apply to the merged result.",
  "type": "object",
  "required": ["format", "version", "id", "title"],
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": "dawlings.layout"},
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}(\\.[a-z][a-z0-9_-]{0,39})*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "extends": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}(\\.[a-z][a-z0-9_-]{0,39})*$"}},
    "order": {"type": ["integer", "null"], "minimum": 0, "description": "position in the venue cycle; null or absent = not cycled"},
    "shell": {"$ref": "#/$defs/shell"},
    "mood": {"$ref": "#/$defs/mood"},
    "zones": {"$ref": "#/$defs/zones"},
    "pieces": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/placement"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "wiring": {"type": "array", "items": {"$ref": "#/$defs/wire"}},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "zones": {"$ref": "#/$defs/zones"},
          "pieces": {"type": "array", "items": {"$ref": "#/$defs/placement"}},
          "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
          "wiring": {"type": "array", "items": {"$ref": "#/$defs/wire"}}
        }
      }
    }
  },
  "$defs": {
    "number": {"type": "number", "minimum": -200, "maximum": 200},
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/number"}},
    "triple": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/number"}},
    "anchor_name": {
      "type": "string",
      "pattern": "^(?:(?:wall|control_wall)\\.(?:left|right)|control_rear|live_back|mix|annex_edge|zone\\.[a-z][a-z0-9_]*(?:\\.(?:cx|cz|min|max))?)$"
    },
    "shell": {
      "type": "object",
      "description": "Shell geometry stays in code (decision 1): 'builder' names it. Sizes are settled in queue slice 8; any short name is accepted until then.",
      "properties": {
        "builder": {"type": "string"}, "kit": {"type": "string"}, "size": {"type": "string"}, "style": {"type": "string"}
      }
    },
    "mood": {
      "type": "object",
      "properties": {
        "base": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "hit": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "glow": {"type": "number", "minimum": 0, "maximum": 4}
      }
    },
    "zones": {
      "type": "object",
      "description": "id -> zone box; null in an override removes the zone.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,39}$"},
      "additionalProperties": {
        "type": ["object", "null"],
        "properties": {
          "min": {"$ref": "#/$defs/triple"},
          "size": {"$ref": "#/$defs/triple"},
          "grow": {"enum": ["outward", "inward", "none"]}
        }
      }
    },
    "at": {
      "type": "object",
      "description": "Anchor form {anchor, pos, yaw} or frame form {frame, local, yaw}, never both. Replaces whole when merged.",
      "properties": {
        "anchor": {"type": "object", "properties": {"x": {"$ref": "#/$defs/anchor_name"}, "z": {"$ref": "#/$defs/anchor_name"}}},
        "pos": {"$ref": "#/$defs/pair"},
        "frame": {"type": "string", "pattern": "^authored:[a-z][a-z0-9_]{0,39}$"},
        "local": {"$ref": "#/$defs/pair"},
        "yaw": {"type": "number", "minimum": -1000, "maximum": 1000}
      }
    },
    "placement": {
      "type": "object",
      "required": ["id"],
      "description": "'piece' is required on the merged result; an override may omit it.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "piece": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
        "at": {"$ref": "#/$defs/at"},
        "mobility": {"enum": ["wheeled", "fixed"]},
        "enabled": {"type": "boolean", "default": true}
      }
    },
    "group": {
      "type": "object",
      "required": ["id"],
      "description": "'title' and 'members' are required on the merged result.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "title": {"type": "string", "minLength": 1},
        "colour": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "lift": {"type": "number", "minimum": -10, "maximum": 10},
        "members": {"type": "array", "items": {"type": "string"}}
      }
    },
    "wire": {
      "type": "object",
      "required": ["kind", "from", "to"],
      "description": "Identified by kind|from|to when merged; 'enabled': false removes it. 'from' and 'to' are piece ids or live_room / control_room.",
      "properties": {
        "kind": {"enum": ["feeds", "rides", "loom", "opens_onto"]},
        "from": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "to": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
        "enabled": {"type": "boolean", "default": true}
      }
    }
  }
}
