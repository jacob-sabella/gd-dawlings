    {"kind": "rack_module", "type": "ladder", "title": "LADDER", "group": "Filter", "blurb": "A Moog-style ladder filter that sings when pushed.", "sound": {"kind": "engine", "type": "ladder"}, "skin": {"face": "#2E1247", "accent": "#CC59FF", "pattern": "stripes", "tagline": "SQUELCH"}, "pad_knobs": ["cutoff", "res"]},
    {"kind": "rack_module", "type": "fold", "title": "FOLD", "group": "Shape", "blurb": "A wavefolder: harmonics from folding the wave back on itself.", "sound": {"kind": "engine", "type": "fold"}, "skin": {"face": "#47122B", "accent": "#FF59A6", "pattern": "zigzag", "tagline": "ORIGAMI"}, "pad_knobs": ["gain", "offset"]},
    {"kind": "rack_module", "type": "drive", "title": "DRIVE", "group": "Shape", "blurb": "Soft overdrive.", "sound": {"kind": "engine", "type": "drive"}, "skin": {"face": "#4D170A", "accent": "#FF7326", "pattern": "stripes", "tagline": "HOT HOT HOT"}, "pad_knobs": ["drive", "level"]},
    {"kind": "rack_module", "type": "crush", "title": "CRUSH", "group": "Shape", "blurb": "Sample-rate and bit reduction.", "sound": {"kind": "engine", "type": "crush"}, "skin": {"face": "#1A1F42", "accent": "#738CFF", "pattern": "checker", "tagline": "CRUNCH"}, "pad_knobs": ["rate", "bits"]},
    {"kind": "rack_module", "type": "delay", "title": "DELAY", "group": "Time", "blurb": "A stereo echo: free or tied to the song's tempo, with a ping-pong.", "sound": {"kind": "engine", "type": "delay"}, "skin": {"face": "#0D333D", "accent": "#59F2FF", "pattern": "dots", "tagline": "ECHO ECHO"}, "pad_knobs": ["time", "fb"]},
    {"kind": "rack_module", "type": "chorus", "title": "CHORUS", "group": "Time", "blurb": "Thickens a sound with a slow, swimming copy of itself.", "sound": {"kind": "engine", "type": "chorus"}, "skin": {"face": "#123B3D", "accent": "#73FFD9", "pattern": "wave", "tagline": "SHIMMER"}, "pad_knobs": ["rate", "depth"]},
    {"kind": "rack_module", "type": "out", "title": "OUT", "group": "Mix", "blurb": "The output: to the speakers, and out of the room to a track.", "sound": {"kind": "engine", "type": "out"}, "skin": {"face": "#1A1A1C", "accent": "#FFFFFF", "pattern": "stripes", "tagline": "TO THE DAW"}}
