  "provides": [
    {"kind": "rack_module", "type": "keys", "title": "KEYS", "group": "Source", "blurb": "Your notes: pitch, gate, velocity, the mod wheel and the bend.", "sound": {"kind": "engine", "type": "keys"}, "skin": {"face": "#4D1A1F", "accent": "#FF594D", "pattern": "checker", "tagline": "PLAY ME"}, "pad_knobs": ["oct", "glide"]},
    {"kind": "rack_module", "type": "clock", "title": "CLOCK", "group": "Control", "blurb": "Tempo as pulses: 16ths, 8ths, beats and bars; locked to the song or free.", "sound": {"kind": "engine", "type": "clock"}, "skin": {"face": "#382B0D", "accent": "#FFC726", "pattern": "stripes", "tagline": "TICK TOCK"}, "pad_knobs": ["bpm", "swing"]},
    {"kind": "rack_module", "type": "seq", "title": "SEQ", "group": "Control", "blurb": "Sixteen steps of pitch (or rest) advanced by a clock.", "sound": {"kind": "engine", "type": "seq"}, "skin": {"face": "#0F3342", "accent": "#40E6F2", "pattern": "bars", "tagline": "STEP UP"}},
    {"kind": "rack_module", "type": "lfo", "title": "LFO", "group": "Control", "blurb": "A slow oscillator for movement.", "sound": {"kind": "engine", "type": "lfo"}, "skin": {"face": "#123D2B", "accent": "#59FF99", "pattern": "wave", "tagline": "WOBBLE"}, "pad_knobs": ["rate", "depth"]},
    {"kind": "rack_module", "type": "noise", "title": "NOISE", "group": "Source", "blurb": "White and pink noise.", "sound": {"kind": "engine", "type": "noise"}, "skin": {"face": "#333338", "accent": "#D9D9E6", "pattern": "dots", "tagline": "SSSHHH"}},
    {"kind": "rack_module", "type": "sh", "title": "S&H", "group": "Control", "blurb": "Samples its input on each trigger (noise when unpatched).", "sound": {"kind": "engine", "type": "sh"}, "skin": {"face": "#2E2942", "accent": "#B399FF", "pattern": "bars", "tagline": "DICE ROLL"}},
    {"kind": "rack_module", "type": "slew", "title": "SLEW", "group": "Control", "blurb": "Smooths a signal: glide, lag and portamento.", "sound": {"kind": "engine", "type": "slew"}, "skin": {"face": "#143338", "accent": "#66F2D9", "pattern": "wave", "tagline": "GLIDE"}, "pad_knobs": ["rise", "fall"]},
    {"kind": "rack_module", "type": "att", "title": "ATT", "group": "Control", "blurb": "Scales, flips and offsets a signal.", "sound": {"kind": "engine", "type": "att"}, "skin": {"face": "#333321", "accent": "#E6E680", "pattern": "stripes", "tagline": "EASY NOW"}, "pad_knobs": ["gain", "offset"]},
    {"kind": "rack_module", "type": "quant", "title": "QUANT", "group": "Control", "blurb": "Snaps a pitch to a scale.", "sound": {"kind": "engine", "type": "quant"}, "skin": {"face": "#421F38", "accent": "#FF80D9", "pattern": "checker", "tagline": "IN TUNE"}, "pad_knobs": ["scale", "root"]},
    {"kind": "rack_module", "type": "vca", "title": "VCA", "group": "Shape", "blurb": "Amplifier: its level set by a control signal.", "sound": {"kind": "engine", "type": "vca"}, "skin": {"face": "#1F381A", "accent": "#99F259", "pattern": "bars", "tagline": "VOLUME"}},
    {"kind": "rack_module", "type": "mix", "title": "MIX", "group": "Mix", "blurb": "Four inputs to one.", "sound": {"kind": "engine", "type": "mix"}, "skin": {"face": "#38331A", "accent": "#F2D966", "pattern": "bars", "tagline": "ALL TOGETHER"}},
    {"kind": "rack_module", "type": "scope", "title": "SCOPE", "group": "Mix", "blurb": "A screen on the wall: the wave of whatever is patched in, passed on.", "sound": {"kind": "engine", "type": "scope"}, "skin": {"face": "#0A1F1A", "accent": "#66FFB3", "pattern": "wave", "tagline": "WHAT DO YOU SEE"}, "pad_knobs": ["time", "gain"]},
    {"kind": "rack_module", "type": "world", "title": "WORLD", "group": "Source", "blurb": "The room itself as a source: the weather, the venue's instrument, the looper's rings, each a level and a gate.", "sound": {"kind": "engine", "type": "world"}, "skin": {"face": "#123817", "accent": "#80FF66", "pattern": "dots", "tagline": "LISTEN OUT"}},
    {"kind": "rack_module", "type": "hand", "title": "HAND", "group": "Source", "blurb": "The CV bench in the room as a source: five boxes of two knobs and a slider, set by a hand at the board.", "sound": {"kind": "engine", "type": "hand"}, "skin": {"face": "#3D210A", "accent": "#FFB840", "pattern": "dots", "tagline": "HANDS ON"}}
  ]
}
