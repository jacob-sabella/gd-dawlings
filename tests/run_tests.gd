func _test_a_track_is_duplicated() -> void:
	var backend := GodotBackend.new()
	backend.state = MixState.new()
	DAW.use(backend)
	var s := DAW.state
	# A track with something of everything: effects, a send, items.
	var from := -1
	for i in s.track_indices():
		var t := s.track(i)
		if not t.fx.is_empty() and not t.sends.is_empty() and not t.items.is_empty():
			from = i
			break
	check("the demo has a track with effects, sends and items (%d)" % from, from > 0)
	if from < 0:
		_offline()
		return
	DAW.set_automation(from, "volume", [[0.0, -3.0, DawKitAutomation.HOLD]])
	DAW.set_track_rec_arm(from, true)
	var count := s.track_indices().size()
	var after_name := s.track(from + 1).name if s.tracks.has(from + 1) else ""
	var original := s.track(from)
	var depth := maxi(s.undo_depth, 0)
	DAW.duplicate_track(from)
	var copy := s.track(from + 1)
	check("a track more, the copy right after it", s.track_indices().size() == count + 1 and copy != original
			and s.track(from) == original)
	check("under the same name, in the same colour", copy.name == original.name and copy.colour == original.colour)
	check("at the same level and pan", is_equal_approx(copy.volume, original.volume) and is_equal_approx(copy.pan, original.pan))
	check("with its effects and their settings (%d)" % copy.fx.size(), copy.fx.size() == original.fx.size()
			and copy.fx.values()[0].name == original.fx.values()[0].name
			and copy.fx.values()[0].params == original.fx.values()[0].params)
	check("its sends", copy.sends.size() == original.sends.size()
			and copy.sends.values()[0].dest_track == original.sends.values()[0].dest_track)
	check("its items", copy.items.size() == original.items.size()
			and copy.items.map(func(it): return it.start) == original.items.map(func(it): return it.start))
	check("and its lanes", copy.automation.has("volume"))
	check("but not armed", not copy.rec_arm and original.rec_arm)
	check("the next track moved down one", after_name == "" or s.track(from + 2).name == after_name)
	check("the engine has a bus for it with the effects on it", backend._bus.has(from + 1)
			and AudioServer.get_bus_effect_count(backend._bus[from + 1]) >= copy.fx.size())
	check("one step to undo", s.undo_depth - depth == 1)
	DAW.undo()
	check("undone, gone", s.track_indices().size() == count and s.track(from) == original
			and (after_name == "" or s.track(from + 1).name == after_name))
	DAW.set_track_rec_arm(from, false)
	# A folder's last track: the copy closes the folder instead.
	var last := -1
	for i in s.track_indices():
		if s.track(i).folder_depth < 0:
			last = i
			break
	if last > 0:
		var closes := s.track(last).folder_depth
		DAW.duplicate_track(last)
		check("a folder's last track's copy stays in the folder, and closes it",
				s.track(last).folder_depth == 0 and s.track(last + 1).folder_depth == closes)
		DAW.undo()
	DAW.apply_intent(&"duplicate_track", [from])
	check("a guest may ask for one", &"duplicate_track" in DAW.COMMANDS and s.track_indices().size() == count + 1)
	DAW.undo()
	DAW.apply_intent(&"duplicate_track", ["x"])
	DAW.apply_intent(&"duplicate_track", [0])
	check("a malformed one is refused", s.track_indices().size() == count)

	_offline()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineTrackPage = timeline.track_page
	check("the TRACK page has a duplicate token, dark with no track picked", page.duplicate != null
			and page.duplicate.glyph == &"track_duplicate" and not page.duplicate.lit and not page.duplicate.available)
	timeline.pick_track(2)
	page.refresh()
	check("lit with one", page.duplicate.lit and page.duplicate.available)
	var before := DAW.state.track_indices().size()
	page.duplicate.pressed.emit()
	check("pressed, the picked track is copied and the copy picked", DAW.state.track_indices().size() == before + 1
			and DAW.state.track(3).name == DAW.state.track(2).name and timeline.picked_track == 3)
	timeline.free()
	_offline()


func _test_the_selection_is_nudged_by_the_grid() -> void:
	_offline()
	var s := DAW.state
	var lane := 2
	var starts: Array = s.track(lane).items.map(func(it): return it.start)
	var beat := 60.0 / s.tempo
	var depth := maxi(s.undo_depth, 0)
	DAW.select_item(lane, 1, false)
	DAW.nudge_selected(1.0, DAWBackend.NUDGE_BEATS)
	close_to("a beat later", s.track(lane).items[1].start, float(starts[1]) + beat)
	check("the others stay", is_equal_approx(s.track(lane).items[0].start, float(starts[0]))
			and is_equal_approx(s.track(lane).items[2].start, float(starts[2])))
	check("one step to undo", s.undo_depth - depth == 1)
	DAW.nudge_selected(-1.0, DAWBackend.NUDGE_BARS)
	close_to("a bar earlier", s.track(lane).items[1].start, float(starts[1]) + beat - 4.0 * beat)
	DAW.nudge_selected(0.01, DAWBackend.NUDGE_SECONDS)
	close_to("ten milliseconds later", s.track(lane).items[1].start, float(starts[1]) - 3.0 * beat + 0.01)
	DAW.undo()
	DAW.undo()
	DAW.undo()
	check("undone, where it was", is_equal_approx(s.track(lane).items[1].start, float(starts[1])))
	# Several at once, a locked one staying put, none before the song's start.
	DAW.select_item(lane, 0, false)
	DAW.select_item(lane, 2, true)
	DAW.set_item_locked(lane, 2, true)
	DAW.nudge_selected(-1000.0, DAWBackend.NUDGE_BEATS)
	check("nothing goes before the start, and a locked one stays",
			s.track(lane).items[0].start == 0.0 and is_equal_approx(s.track(lane).items[2].start, float(starts[2])))
	DAW.undo()
	DAW.set_item_locked(lane, 2, false)
	DAW.clear_item_selection()
	var flat := s.undo_depth
	DAW.nudge_selected(1.0, DAWBackend.NUDGE_BEATS)
	check("nothing selected, nothing moved, no step", s.undo_depth == flat
			and s.track(lane).items.map(func(it): return it.start) == starts)
	DAW.select_item(lane, 1, false)
	DAW.apply_intent(&"nudge_selected", [2.0, 1.0])
	close_to("a guest may ask for one", s.track(lane).items[1].start, float(starts[1]) + 2.0 * beat)
	DAW.undo()
	DAW.apply_intent(&"nudge_selected", [1.0, 7.0])
	DAW.apply_intent(&"nudge_selected", [INF, 1.0])
	check("a malformed one is refused", is_equal_approx(s.track(lane).items[1].start, float(starts[1])))

	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	page.refresh()
	check("the ITEM page has the two nudge tokens, lit with a selection", page.nudge_earlier.glyph == &"nudge_earlier"
			and page.nudge_later.glyph == &"nudge_later" and page.nudge_later.lit and page.nudge_later.available)
	var was_grid := TimelineLanes.grid
	TimelineLanes.grid = 0.5
	page.nudge_later.pressed.emit()
	close_to("pressed, half a beat later on a half-beat grid", s.track(lane).items[1].start, float(starts[1]) + 0.5 * beat)
	check("its card says so (%s)" % page.nudge_later.describe_value.call(0.0),
			page.nudge_later.describe_value.call(0.0).begins_with("the selection half a beat later"))
	TimelineLanes.grid = TimelineLanes.BAR
	page.nudge_earlier.pressed.emit()
	close_to("on the bar grid, a bar earlier", s.track(lane).items[1].start, float(starts[1]) + 0.5 * beat - 4.0 * beat)
	TimelineLanes.grid = TimelineLanes.OFF
	check("with no grid, ten milliseconds", TimelineItemPage.nudge_step(false) == [0.01, DAWBackend.NUDGE_SECONDS])
	TimelineLanes.grid = was_grid
	DAW.clear_item_selection()
	page.refresh()
	check("dark with nothing selected", not page.nudge_later.lit and not page.nudge_later.available)
	timeline.free()
	_offline()


func _test_an_item_fades_with_equal_power() -> void:
	var it := MixState.ItemState.new()
	it.start = 10.0
	it.length = 4.0
	it.fade_in = 2.0
	close_to("halfway through a straight fade, half the amplitude", it.level_db(11.0), linear_to_db(0.5))
	it.fade_shape = DawKitClip.FADE_EQUAL_POWER
	close_to("halfway through an equal-power one, half the power", it.level_db(11.0), linear_to_db(sin(PI * 0.25)))
	close_to("and full once it is through", it.level_db(13.0), 0.0)
	it.fade_shape = DawKitClip.FADE_SLOW
	close_to("a slow one is a quarter of the way up halfway", it.level_db(11.0), linear_to_db(0.25))
	it.fade_shape = DawKitClip.FADE_FAST
	close_to("a fast one three quarters", it.level_db(11.0), linear_to_db(0.75))
	it.fade_shape = DawKitClip.FADE_S_CURVE
	close_to("an S-curve a quarter of the way in", it.level_db(10.5), linear_to_db(0.5 - 0.5 * cos(PI * 0.25)))
	it.fade_in = 0.0
	it.fade_out = 2.0
	it.fade_out_shape = DawKitClip.FADE_SLOW
	close_to("the fade out has its own, the same curve run backwards", it.level_db(13.0), linear_to_db(0.25))
	var pts := TimelineSurface.fade_points(0.0, 1.0, 0.0, 1.0, DawKitClip.FADE_EQUAL_POWER)
	check("drawn as a curve, above the straight line in its middle", pts.size() == TimelineSurface.FADE_SEGMENTS + 1
			and pts[2].y > pts[2].x and pts[0] == Vector2.ZERO and pts[-1].is_equal_approx(Vector2.ONE))
	var slow := TimelineSurface.fade_points(0.0, 1.0, 0.0, 1.0, DawKitClip.FADE_SLOW)
	check("a slow one below it", slow.size() == TimelineSurface.FADE_SEGMENTS + 1 and slow[2].y < slow[2].x)
	check("a straight one as a line", TimelineSurface.fade_points(0.0, 1.0, 0.0, 1.0, DawKitClip.FADE_LINEAR).size() == 2)

	var backend := GodotBackend.new()
	backend.state = MixState.new()
	DAW.use(backend)
	var s := DAW.state
	var lane := 2
	DAW.set_item_fades(lane, 1, 0.5, 0.5)
	var depth := maxi(s.undo_depth, 0)
	backend._repl_durable.clear()
	DAW.set_item_fade_shape(lane, 1, DawKitClip.FADE_EQUAL_POWER, DawKitClip.FADE_S_CURVE)
	check("set, each end its own", s.item(lane, 1).fade_shape == DawKitClip.FADE_EQUAL_POWER
			and s.item(lane, 1).fade_out_shape == DawKitClip.FADE_S_CURVE)
	check("one step to undo", s.undo_depth - depth == 1)
	check("and replicated with the lane", backend._repl_durable.has("/track/%d/items" % lane))
	var guest := MixState.new()
	MixWire.apply_replicated(guest, MixWire.snapshot(s))
	check("a guest reads both", guest.item(lane, 1).fade_shape == DawKitClip.FADE_EQUAL_POWER
			and guest.item(lane, 1).fade_out_shape == DawKitClip.FADE_S_CURVE)
	var lanes := LaneEngine.new()
	lanes.backend = backend
	var both := func(c): return c["fade_shape"] == DawKitClip.FADE_EQUAL_POWER and c["fade_out_shape"] == DawKitClip.FADE_S_CURVE
	var shaped := lanes.clips_for(lane).filter(both)
	check("the engine plays it with both (%d clips)" % shaped.size(), not shaped.is_empty())
	lanes.free()
	var flat := s.undo_depth
	DAW.set_item_fade_shape(lane, 1, DawKitClip.FADE_EQUAL_POWER, DawKitClip.FADE_S_CURVE)
	check("set again, no step", s.undo_depth == flat)
	var p := ProjectBridge.capture(backend)
	var fresh := OfflineBackend.new()
	fresh.state = MixState.new()
	add_child(fresh)
	ProjectBridge.load(p, fresh)
	check("saved with the project", fresh.state.item(lane, 1).fade_shape == DawKitClip.FADE_EQUAL_POWER
			and fresh.state.item(lane, 1).fade_out_shape == DawKitClip.FADE_S_CURVE)
	fresh.free()
	DAW.select_item(lane, 1, false)
	DAW.split_selected(s.item(lane, 1).start + s.item(lane, 1).length * 0.5)
	var kept := func(x): return x.fade_shape == DawKitClip.FADE_EQUAL_POWER and x.fade_out_shape == DawKitClip.FADE_S_CURVE
	check("both halves of a cut keep them", s.track(lane).items.filter(kept).size() == 2)
	DAW.undo()
	DAW.clear_item_selection()
	DAW.undo()
	check("undone, straight again", s.item(lane, 1).fade_shape == DawKitClip.FADE_LINEAR
			and s.item(lane, 1).fade_out_shape == DawKitClip.FADE_LINEAR)
	DAW.apply_intent(&"set_item_fade_shape", [lane, 1, 7.0, -2.0])
	check("a guest's odd shapes are straight ones", s.item(lane, 1).fade_shape == DawKitClip.FADE_LINEAR
			and s.item(lane, 1).fade_out_shape == DawKitClip.FADE_LINEAR)
	DAW.apply_intent(&"set_item_fade_shape", [lane, 1, 1.0])
	check("one shape alone is refused", s.item(lane, 1).fade_shape == DawKitClip.FADE_LINEAR)
	DAW.apply_intent(&"set_item_fade_shape", [lane, 1, 2.0, 3.0])
	check("a guest may set them", s.item(lane, 1).fade_shape == DawKitClip.FADE_SLOW
			and s.item(lane, 1).fade_out_shape == DawKitClip.FADE_FAST)
	DAW.undo()
	DAW.set_item_locked(lane, 1, true)
	DAW.set_item_fade_shape(lane, 1, DawKitClip.FADE_EQUAL_POWER, DawKitClip.FADE_EQUAL_POWER)
	check("a locked item refuses it", s.item(lane, 1).fade_shape == DawKitClip.FADE_LINEAR)
	DAW.set_item_locked(lane, 1, false)
	var old := DawKitClip.from_dict({"fade_shape": 1})
	check("a clip saved with one shape has it at both ends", old.fade_out_shape == DawKitClip.FADE_EQUAL_POWER)

	_offline()
	DAW.set_item_fades(lane, 1, 0.5, 0.5)
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	DAW.select_item(lane, 1, false)
	page.refresh()
	check("the ITEM page has a shape token for each end, straight", page.fade_in_shape.glyph == &"fade_linear"
			and page.fade_out_shape.glyph == &"fade_out_linear" and not page.fade_in_shape.lit
			and page.fade_in_shape.available and page.fade_out_shape.available)
	page.fade_in_shape.pressed.emit()
	check("the fade in's pressed, equal power, its mark the curve; the fade out as it was",
			DAW.state.item(lane, 1).fade_shape == DawKitClip.FADE_EQUAL_POWER
			and DAW.state.item(lane, 1).fade_out_shape == DawKitClip.FADE_LINEAR
			and page.fade_in_shape.glyph == &"fade_power" and page.fade_in_shape.lit and not page.fade_out_shape.lit)
	check("its card names this shape and the next (%s)" % _shape_card(page.fade_in_shape),
			_shape_card(page.fade_in_shape) == "equal power; press for slow, then quick")
	for k in 4:
		page.fade_out_shape.pressed.emit()
	check("the fade out's round to an S-curve", DAW.state.item(lane, 1).fade_out_shape == DawKitClip.FADE_S_CURVE
			and page.fade_out_shape.glyph == &"fade_out_s" and page.fade_out_shape.lit)
	timeline._process(0.0)
	check("and the fades drawn as curves", timeline._item_fades.count() >= DAW.state.track(lane).items.size() * 2 * TimelineSurface.FADE_SEGMENTS)
	page.fade_out_shape.pressed.emit()
	check("and round again to straight", DAW.state.item(lane, 1).fade_out_shape == DawKitClip.FADE_LINEAR)
	DAW.clear_item_selection()
	timeline.free()
	_offline()


func _shape_card(key: GlyphKey) -> String:
	return String(key.describe_value.call(0.0)) if key.describe_value.is_valid() else ""


func _test_history_can_be_jumped_through() -> void:
	var backend := _offline()
	var s := DAW.state
	backend.forget_history()
	var base := s.undo_depth
	check("a fresh history has nothing in it", base == 0 and s.undo_names.is_empty())
	var kick := s.track(2).display_name()
	DAW.set_track_volume(2, 0.3)
	DAW.move_item(2, 1, s.item(2, 1).start + 1.0)
	DAW.add_marker(12.0, "Here")
	DAW.duplicate_track(3)
	check("four steps, each named for what it did and where (%s)" % [s.undo_names], s.undo_names.size() == 4
			and s.undo_names[0] == "%s: volume" % kick and s.undo_names[1] == "%s: move item" % kick
			and s.undo_names[2] == "add marker" and String(s.undo_names[3]).ends_with(": duplicate track"))
	var start1 := s.item(2, 1).start
	DAW.undo_to(1)
	check("jumped back to after the first, in one go", s.undo_depth == 1 and s.redo_depth == 3
			and not s.markers.has(12.0) and not is_equal_approx(s.item(2, 1).start, start1))
	check("the names stay, the ones to redo after (%s)" % [s.undo_names], s.undo_names.size() == 4
			and s.undo_names[3].ends_with(": duplicate track"))
	DAW.undo_to(3)
	check("and forward again to after the third", s.undo_depth == 3 and s.markers.has(12.0))
	DAW.undo_to(99)
	check("past the end is the end", s.undo_depth == 4 and s.redo_depth == 0)
	DAW.undo_to(0)
	check("and 0 is the start", s.undo_depth == 0 and s.redo_depth == 4)
	DAW.undo_to(4)
	backend._repl_durable.clear()
	DAW.undo()
	check("the names go to guests with the depth", backend._repl_durable.has("/undo")
			and (backend._repl_durable["/undo"] as Array).size() == 6)
	var guest := MixState.new()
	MixWire.apply(guest, "/undo", backend._repl_durable["/undo"])
	check("and a guest reads them", guest.undo_depth == 3 and guest.undo_names == s.undo_names)
	DAW.apply_intent(&"undo_to", [1.0])
	check("a guest may jump", s.undo_depth == 1)
	DAW.apply_intent(&"undo_to", ["x"])
	check("not with nonsense", s.undo_depth == 1)
	DAW.undo_to(4)

	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var rail := timeline._history
	check("the history rail is on the tools, its bead at the end", rail != null and rail in timeline.deck.tools
			and rail.glyph == &"history" and rail.available and is_equal_approx(rail.value, 1.0))
	check("its card names where it is (%s)" % rail.describe_value.call(1.0),
			rail.describe_value.call(1.0).begins_with("where it is now, 4 of 4"))
	check("and where a place along it goes (%s)" % rail.describe_value.call(0.5),
			rail.describe_value.call(0.5) == "back to after %s: move item, 2 of 4" % kick)
	check("and its start (%s)" % rail.describe_value.call(0.0), rail.describe_value.call(0.0).begins_with("back to the start, before"))
	rail.value_committed.emit(0.5)
	check("let go there, the history goes there", s.undo_depth == 2)
	timeline._process(0.0)
	check("and the bead with it", is_equal_approx(rail.value, 0.5))
	timeline.free()
	_offline()


func _test_items_glue_into_one() -> void:
	var backend := _offline()
	var s := DAW.state
	var lane := 7
	var at := func(start: float) -> int:
		for k in s.track(lane).items.size():
			if is_equal_approx(s.item(lane, k).start, start):
				return k
		return -1
	DAW.insert_midi_take(lane, 300.0, 302.0, [[300.25, 300.75, 60, 100, 0], [301.5, 302.0, 64, 90, 0]], "A")
	DAW.insert_midi_take(lane, 303.0, 304.0, [[303.25, 303.5, 67, 80, 0]], "B")
	var count := s.track(lane).items.size()
	DAW.clear_item_selection()
	DAW.select_item(lane, at.call(300.0), false)
	DAW.select_item(lane, at.call(303.0), true)
	check("two MIDI items on a track glue", DAWBackend.glue_picks(s).has(lane))
	var depth := s.undo_depth
	DAW.glue_selected()
	var glued := s.item(lane, at.call(300.0))
	check("into one, from the first's start to the last's end",
			s.track(lane).items.size() == count - 1 and glued != null and is_equal_approx(glued.length, 4.0)
			and at.call(303.0) == -1 and glued.selected)
	var notes := MidiTake.unpack_relative(glued.notes, glued.start)
	check("with every note where it played (%s)" % [notes], notes.size() == 3
			and is_equal_approx(notes[2][0], 303.25) and notes[2][2] == 67 and is_equal_approx(notes[1][1], 302.0))
	check("one step", s.undo_depth == depth + 1)
	DAW.undo()
	check("undone, two again", s.track(lane).items.size() == count and at.call(303.0) != -1)

	DAW.insert_audio_take(lane, 310.0, "suite-glue.wav", 2.0, PackedByteArray())
	DAW.clear_item_selection()
