	Session.layout = saved_layout


func _test_an_item_plays_backwards() -> void:
	var backend := GodotBackend.new()
	backend.state = MixState.new()
	DAW.use(backend)
	var s := DAW.state
	# Two seconds rising from silence, so which end is which can be heard.
	var take := AudioTake.create("suite-reverse-take.wav")
	var ramp := PackedVector2Array()
	ramp.resize(AudioTake.RATE * 2)
	for i in ramp.size():
		ramp[i] = Vector2.ONE * 0.9 * float(i) / ramp.size()
	take.append(AudioTake.encode(ramp))
	take.finish()
	var lane := 6
	s.track(lane).items.clear()
	DAW.insert_audio_take(lane, 300.0, take.file_name(), take.seconds(), take.peaks(), "Grace audio 1")
	DAW.select_item(lane, 0, false)
	DAW.split_selected(300.25)
	DAW.clear_item_selection()
	DAW.select_item(lane, 1, false)
	DAW.split_selected(301.25)
	DAW.clear_item_selection()
	var mid: MixState.ItemState = s.item(lane, 1)
	check("the middle of the take, a quarter second in, a second long",
			is_equal_approx(mid.source_offset, 0.25) and is_equal_approx(mid.length, 1.0))
	close_to("the engine knows the file's length to the sample", backend.source_seconds(mid), 2.0, 0.001)
	var forward_peaks := mid.peaks
	var depth := maxi(s.undo_depth, 0)
	DAW.set_item_reversed(lane, 1, true)
	mid = s.item(lane, 1)
	check("reversed", mid.reversed and s.undo_depth - depth == 1)
	close_to("its offset is now into the reversed sound: what was its right edge", mid.source_offset, 0.75, 0.001)
	var back := forward_peaks.duplicate()
	back.reverse()
	check("and its overview turned round, so it is drawn as it sounds", mid.peaks == back)
	var fwd := backend.take_stream(take.file_name())
	var rev := backend.take_stream(take.file_name(), true)
	check("the engine has the sound backwards", rev != null and rev != fwd and rev.data.size() == fwd.data.size()
			and rev.data.slice(0, 4) == fwd.data.slice(fwd.data.size() - 4))
	s.position_seconds = 300.35
	s.playing = true
	backend._sync_players()
	var own: AudioStreamPlayer = backend._players[lane][0]
	check("and plays it for the reversed item", own.playing and own.stream == rev)
	close_to("from where the item is in it", mid.file_time(300.35), 0.85, 0.001)
	s.playing = false
	backend._sync_players()
	var guest := MixState.new()
	MixWire.apply_replicated(guest, MixWire.snapshot(s))
	check("a guest sees it reversed", guest.item(lane, 1) != null and guest.item(lane, 1).reversed)
	var p := ProjectBridge.capture(backend)
	check("and it is saved reversed", p.track("t%d" % lane).clips[1].reversed)
	DAW.set_item_reversed(lane, 1, false)
	close_to("forwards again, its offset is back", s.item(lane, 1).source_offset, 0.25, 0.001)
	DAW.undo()
	DAW.undo()
	check("undone", not s.item(lane, 1).reversed)
	check("a guest may ask", &"set_item_reversed" in DAW.COMMANDS)
	DAW.insert_midi_take(lane, 320.0, 322.0, [[320.0, 320.5, 60, 100, 0]], "Keys")
	var midi_index := s.track(lane).items.size() - 1
	DAW.set_item_reversed(lane, midi_index, true)
	check("a MIDI item is not reversed", not s.item(lane, midi_index).reversed)
	DAW.set_item_locked(lane, 1, true)
	DAW.set_item_reversed(lane, 1, true)
	check("nor a locked one", not s.item(lane, 1).reversed)
	DAW.set_item_locked(lane, 1, false)

	var mono := AudioStreamWAV.new()
	mono.format = AudioStreamWAV.FORMAT_16_BITS
	mono.data = PackedByteArray([1, 2, 3, 4, 5, 6])
	check("a mono stream turns round frame by frame",
			GodotBackend.reversed_stream(mono).data == PackedByteArray([5, 6, 3, 4, 1, 2]))

	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	DAW.select_item(lane, 1, false)
	page.refresh()
	check("a REVERSE token on the item page, in reach and dark", page.reverse != null
			and page.reverse.glyph == &"reverse" and page.reverse.available and not page.reverse.lit)
	page.reverse.pressed.emit()
	check("pressed, the item is reversed and the token lit", s.item(lane, 1).reversed and page.reverse.lit)
	DAW.select_item(lane, midi_index, false)
	page.refresh()
	check("out of reach for a MIDI item", not page.reverse.available)
	DAW.clear_item_selection()
	timeline.free()
	DirAccess.remove_absolute(backend.media_path(take.file_name()))
	_offline()


func _test_a_reopened_take_is_drawn() -> void:
	var backend := GodotBackend.new()
	backend.state = MixState.new()
	DAW.use(backend)
	var s := DAW.state
	var take := AudioTake.create("suite-reopen-take.wav")
	var swell := PackedVector2Array()
	swell.resize(AudioTake.RATE * 2)
	for i in swell.size():
		swell[i] = Vector2.ONE * sin(TAU * 110.0 * i / AudioTake.RATE) * 0.9 * float(i) / swell.size()
	take.append(AudioTake.encode(swell))
	take.finish()
	var lane := 6
	s.track(lane).items.clear()
	DAW.insert_audio_take(lane, 10.0, take.file_name(), take.seconds(), take.peaks(), "Grace audio 1")
	DAW.insert_audio_take(lane, 20.0, take.file_name(), take.seconds(), take.peaks(), "Grace audio 2")
	DAW.set_item_reversed(lane, 1, true)
	var recorded := take.peaks()
	var read := AudioTake.overview_of(backend.media_path(take.file_name()))
	var worst := 0
	for i in mini(read.size(), recorded.size()):
		worst = maxi(worst, absi(int(read[i]) - int(recorded[i])))
	check("a file's overview read from it is the one made as it was recorded (%d vs %d, off by %d)" % [read.size(),
			recorded.size(), worst], absi(read.size() - recorded.size()) <= 1 and worst <= 3)
	check("and a file that is not there has none", AudioTake.overview_of("/nowhere/at/all.wav").is_empty())
	var path := ProjectSettings.globalize_path("user://suite_reopen/take.dawproject")
	var warnings := ProjectFiles.save(backend, path)
	var fresh := GodotBackend.new()
	fresh.state = MixState.new()
	DAW.use(fresh)
	var refused := ProjectFiles.open(fresh, path)
	check("saved and reopened (%s %s)" % [warnings, refused], refused.is_empty())
	var items: Array = DAW.state.track(lane).items
	check("its takes are drawn, not blank (%s)" % [items.map(func(it): return it.peaks.size())],
			items.size() == 2 and items.all(func(it): return it.peaks.size() >= recorded.size() - 1))
	if items.size() == 2:
		check("the forward take louder at its end, as recorded", items[0].peaks[-5] > items[0].peaks[5] + 50)
		check("the reversed one louder at its start, as it sounds", items[1].reversed and items[1].peaks[5] > items[1].peaks[-5] + 50)
	DirAccess.remove_absolute(backend.media_path(take.file_name()))
	DirAccess.remove_absolute(path)
	# The stand-in hosts too (a run without the engine), and saves like any host.
	var stand_in := _offline()
	var plain := ProjectSettings.globalize_path("user://suite_reopen/stand_in.dawproject")
	var said := ProjectFiles.save(stand_in, plain)
	check("the stand-in saves a project (%s)" % [said], FileAccess.file_exists(plain))
	DirAccess.remove_absolute(plain)
	_offline()


# --- third-party plugins in the built-in engine -------------------------------------------------

## The test CLAP dawkit builds for its own checks (a gain and a sine), as the catalogue lists it,
## or [] where plugins are not hosted.
func _test_plugins() -> Array:
	var path := ProjectSettings.globalize_path("res://vendor/dawkit/native/build/dawkit_test.clap")
	if not HostedPlugins.available() or not FileAccess.file_exists(path):
		return []
	return ClassDB.class_call_static(&"DawKitPlugin", &"scan_file", "CLAP", path)


func _hosting_engine() -> GodotBackend:
	var found := _test_plugins()
	if found.is_empty():
		check("plugins are hosted here, with dawkit's test plugin built", false)
		return null
	PluginCatalogue.use_only(found)
	var backend := GodotBackend.new()
	# Each plugin loaded before add_fx answers, so these checks find the slot whole; the game's
	# load on dawkit's thread is checked by _test_a_plugin_loads_while_the_game_carries_on.
	backend.hosted.threaded = false
	backend.state = MixState.new()
	DAW.use(backend)
	return backend


func _test_the_built_in_engine_hosts_a_plugin_effect() -> void:
	var backend := _hosting_engine()
	if backend == null:
		return
	var s := DAW.state
	var gain := "plugin:CLAP:dawkit.test.gain"
	check("the installed plugins are offered beside Godot's effects",
			s.fx_choices.any(func(c): return c[0] == gain and c[1] == "CLAP: Test Gain")
			and s.fx_choices.any(func(c): return c[0] == "plugin:CLAP:dawkit.test.sine" and c[1] == "CLAPi: Test Sine"))
	var bus: int = backend._bus[6]
	var before := s.track(6).plugins().size()
	DAW.add_fx(6, gain)
	var at: int = s.track(6).plugins()[-1]
	var f := s.fx(6, at)
	var effect := AudioServer.get_bus_effect(bus, 1 + at)
	check("add_fx loads the plugin into the chain and puts it on the bus (%s, %s)" % [f.name, effect.get_class()],
			s.track(6).plugins().size() == before + 1 and f.name == "Test Gain" and f.type == "CLAP"
			and f.host_key != "" and effect.get_class() == "DawKitPluginEffect")
	check("its parameters are the plugin's own", f.param_names.get(0, "") == "Gain" and f.param_list == [0]
			and is_equal_approx(f.params.get(0, -1.0), 0.5))
	DAW.set_fx_param(6, at, 0, 0.25)
	var p = backend.hosted_plugin(6, at)
	check("a knob turned on the desk turns the plugin's", p != null and is_equal_approx(p.get_param(0), 0.25))
	backend.read_fx_param_text(6, at, 0)
	check("and the plugin says what it reads, in its words (%s)" % f.param_text.get(0, ""), f.param_text.get(0, "") == "-6.0 dB")
	check("a plugin with no window of its own offers none, nor does Godot's EQ",
			not backend.has_plugin_window(6, at) and not backend.has_plugin_window(6, 0))
	var key := f.host_key
	DAW.move_fx(6, at, 6, at + 1, true)
	var copy := s.fx(6, at + 1)
	check("a copy of it is a plugin of its own, set the same (%s, %s)" % [key, copy.host_key],
			copy.host_key != "" and copy.host_key != key and backend.hosted_plugin(6, at + 1) != p
			and is_equal_approx(backend.hosted_plugin(6, at + 1).get_param(0), 0.25))
	DAW.undo()
	DAW.remove_fx(6, at)
	check("removed, it is off the bus", backend._fx_end(bus) == 1 + before)
	DAW.undo()
	check("and undone, the same plugin is back, as it was",
			s.fx(6, at).host_key == key and backend.hosted_plugin(6, at) == p
			and AudioServer.get_bus_effect(bus, 1 + at).get_plugin() == p)
	# A guest is told what is in the slot, and nothing of the host's handle on it.
	var guest := MixState.new()
	for pair in MixWire.snapshot(s):
		MixWire.apply(guest, pair[0], pair[1])
	var g := guest.fx(6, at)
	check("a guest sees the plugin by name, with its parameters (%s/%s)" % [g.type, g.name],
			g.name == "Test Gain" and g.type == "CLAP" and g.param_list == [0] and g.host_key == "")
	backend.close()
	PluginCatalogue.use_only([])


func _test_a_hosted_plugin_comes_back_with_its_project() -> void:
	var backend := _hosting_engine()
	if backend == null:
		return
	var s := DAW.state
	DAW.add_fx(6, "plugin:CLAP:dawkit.test.gain")
	var at: int = s.track(6).plugins()[-1]
	DAW.set_fx_param(6, at, 0, 0.8)
	# The plugin takes a value in its next block.
	backend.hosted_plugin(6, at).process(PackedVector2Array([Vector2.ZERO]))
	var project := ProjectBridge.capture(backend)
	var track: DawKitTrack = project.tracks[5]
	var e: DawKitEffect = track.effects[-1]
	check("a saved project keeps the plugin by format and id, with its state (%d bytes)" % e.state.size(),
			e.plugin_format == "CLAP" and e.plugin_id == "dawkit.test.gain" and e.kind == "" and not e.state.is_empty())
	var path := OS.get_temp_dir().path_join("dawlings_plugin_%d.dawproject" % OS.get_process_id())
	DawKitDawproject.save(project, path, OS.get_temp_dir())
	var opened: DawKitProject = DawKitDawproject.open(path, OS.get_temp_dir().path_join("dawlings_plugin_media"))["project"]
	DirAccess.remove_absolute(path)
	var problems := ProjectBridge.load(opened, backend)
	var f := s.fx(6, at)
	var p = backend.hosted_plugin(6, at)
	check("opened again, the plugin is loaded into its slot, set as it was (%s)" % [problems],
			problems.is_empty() and p != null and f.name == "Test Gain" and is_equal_approx(p.get_param(0), 0.8)
			and is_equal_approx(f.params.get(0, 0.0), 0.8))
	check("and is on the track's bus", AudioServer.get_bus_effect(backend._bus[6], 1 + at).get_class() == "DawKitPluginEffect")
	# On a machine without it, it is kept as it came, and saved again unchanged.
	PluginCatalogue.use_only([])
	ProjectBridge.load(opened, backend)
	var kept: DawKitEffect = ProjectBridge.capture(backend).tracks[5].effects[-1]
	check("a plugin this machine lacks is kept, state and all", s.fx(6, at).name == "Test Gain"
			and backend.hosted_plugin(6, at) == null and kept.plugin_id == "dawkit.test.gain" and kept.state == e.state)
	backend.close()


