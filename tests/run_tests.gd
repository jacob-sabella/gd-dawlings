	var plan := DAWBackend.move_plan(depths, 4, 2, 1)
	check("a track moved into a folder", plan.get("order") == [1, 4, 2, 3] and plan.get("depths") == [1, 0, 0, -1])
	plan = DAWBackend.move_plan(depths, 1, 2, 0)
