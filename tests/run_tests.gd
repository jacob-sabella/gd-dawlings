			and page.fit.lit and page.fit.glyph == &"region_fit")
	page.fit.pressed.emit()
	check("FIT makes it the loop range", s.regions[1] == [9.0, 21.0, "Verse"])
	page.refresh()
	check("and then it is dark, fitted", not page.fit.lit)
	var prompt: NamePrompt = timeline.ask_region_name(9.0)
	check("NAME asks for its name", prompt != null and prompt._edit.text == "Verse")
	prompt._edit.text_submitted.emit("Verse A")
	check("and the region has the name typed", s.regions[1][2] == "Verse A")
	timeline.type_on_desk = true
	page.refresh()
	page.rename.pressed.emit()
	var pad: TypingPad = timeline._pad
	check("in a headset, on the keypad", pad != null and pad.text == "Verse A")
	(pad.keys["LEAVE"] as PanelButton).pressed.emit()
	timeline.type_on_desk = false
	check("the list is a rail, at the region the playhead is in", page.list.glyph == &"region_list"
			and page.list.available and is_equal_approx(page.list.value, 0.5))
	check("its card names one (%s)" % page.list.describe_value.call(1.0),
			String(page.list.describe_value.call(1.0)).begins_with("Chorus, ") and String(page.list.describe_value.call(1.0)).ends_with("3 of 3"))
	page.list.value_committed.emit(0.0)
	check("let go on one, the playhead goes to its start", is_equal_approx(s.position_seconds, 2.0))
	s.position_seconds = 31.0
	page._process(0.0)
	check("and it follows the playhead into another as the song plays", is_equal_approx(page.list.value, 1.0))
	timeline.free()
	_offline()
	timeline = TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	check("with none, the list is out of reach", not timeline.region_page.list.available)
	timeline.free()


func _test_the_latency_report_lines_up_the_slowest_path() -> void:
	var st := MixState.new()
	for i in [1, 2, 3]:
		st.tracks[i] = MixState.TrackState.new()
		st.tracks[i].index = i
	st.tracks[1].folder_depth = 1
	st.tracks[2].folder_depth = -1
	st.fx(1, 0).name = "Bus comp"
	st.fx(2, 0).name = "Lead limiter"
	st.fx(2, 1).name = "Reverb"
	st.fx(3, 0).name = "Pad"
	var lat := func(t: int, k: int) -> int: return {"1:0": 64, "2:0": 480, "2:1": 32, "3:0": 0}["%d:%d" % [t, k]]
	var rows := LatencyReport.build(st, lat)
	check("a track's own chain adds up", rows[1]["own"] == 512)
	check("and its folder's after it", rows[1]["path"] == 576 and rows[0]["path"] == 64)
	check("the slowest sets what the others are held back to", LatencyReport.longest(rows) == 576
			and rows[0]["comp"] == 512 and rows[1]["comp"] == 0 and rows[2]["comp"] == 576)
	st.fx(2, 0).enabled = false
	rows = LatencyReport.build(st, lat)
	check("a bypassed plugin adds none", rows[1]["own"] == 32)
	close_to("in milliseconds", LatencyReport.milliseconds(480, 48000.0), 10.0, 0.001)
	check("said in words", LatencyReport.summary(st, rows, 48000.0).contains("ms")
			and LatencyReport.summary(MixState.new(), [], 48000.0) == "no plugin adds latency")
	check("the offline engine hosts nothing, so reports none", DAW.latency_report().all(func(r): return r["path"] == 0))


func _test_a_groove_lends_its_feel() -> void:
	var g := DAWBackend.groove_of([0.0, 0.3, 1.0, 1.3, 2.0, 2.3], 0.5, 2)
	close_to("the off-beats are late by their mean", g[1], -0.2, 0.0001)
	close_to("and the on-beats are on the grid", g[0], 0.0, 0.0001)
	close_to("a note near a late slot is pulled to it", DAWBackend.groove_beat(0.52, 0.5, g), 0.3, 0.0001)
	check("no onsets, no groove", DAWBackend.groove_of([], 0.5).is_empty())
	_offline()
	var s := DAW.state
	var lane := 6
	s.track(lane).items.clear()
	var beat := 60.0 / s.tempo
	# Source: eighths with the off-beats a sixth of a beat late. Target: straight eighths, a hair off.
	DAW.insert_midi_take(lane, 0.0, 2.0 * beat, [[0.0, 0.2 * beat, 60, 100, 0], [0.5 * beat + beat / 6.0, 0.9 * beat, 60, 100, 0],
			[1.0 * beat, 1.2 * beat, 60, 100, 0], [1.5 * beat + beat / 6.0, 1.9 * beat, 60, 100, 0]], "Feel")
	DAW.insert_midi_take(lane, 4.0 * beat, 6.0 * beat, [[4.0 * beat + 0.01, 4.4 * beat, 62, 100, 0],
			[4.5 * beat - 0.01, 4.9 * beat, 62, 100, 0], [5.0 * beat, 5.4 * beat, 62, 100, 0],
			[5.5 * beat + 0.01, 5.9 * beat, 62, 100, 0]], "Straight")
	var depth := maxi(s.undo_depth, 0)
	DAW.groove_item(lane, 1, lane, 0, 0.5, 1.0)
	var notes := MidiTake.unpack_relative(s.item(lane, 1).notes, s.item(lane, 1).start)
	var ons: Array = notes.map(func(n): return n[0] / beat)
	check("the target takes the source's late off-beats (%s)" % [ons],
			absf(ons[0] - 4.0) < 1e-3 and absf(ons[1] - (4.5 + 1.0 / 6.0)) < 1e-3
			and absf(ons[2] - 5.0) < 1e-3 and absf(ons[3] - (5.5 + 1.0 / 6.0)) < 1e-3)
	check("one undo step", s.undo_depth - depth == 1)
	DAW.undo()
	DAW.groove_item(lane, 1, lane, 1, 0.5, 1.0)
	check("an item cannot lend to itself", s.undo_depth - depth == 0)
	DAW.apply_intent(&"groove_item", [lane, 1, lane, 0, 0.5])
	check("the old five-word ask is refused", s.undo_depth - depth == 0)
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	check("a GROOVE token on the item page", page.groove != null and page.groove.glyph == &"groove")
	DAW.select_item(lane, 1, false)
	page.refresh()
	check("out of reach with one item (%s, %s)" % [s.selected_items(), page.groove.available], not page.groove.available)
	DAW.select_item(lane, 0, true)
	page.refresh()
	check("in reach with two", page.groove.available and page.groove.lit)
	page.groove.pressed.emit()
	notes = MidiTake.unpack_relative(s.item(lane, 1).notes, s.item(lane, 1).start)
	check("pressed, the second item is grooved (%.3f)" % (notes[1][0] / beat), absf(notes[1][0] / beat - (4.5 + 1.0 / 6.0)) < 1e-3)
	DAW.undo()
	timeline.queue_free()


func _test_a_vca_trims_its_group() -> void:
	var backend := _offline()
	var s := DAW.state
	var fader := s.track(2).volume
	var depth := maxi(s.undo_depth, 0)
	backend._repl_durable.clear()
	DAW.set_vca(1, -6.0)
	close_to("a group's VCA holds its trim", s.vca_db(1), -6.0, 0.001)
	check("faders stay where they were", is_equal_approx(s.track(2).volume, fader))
	check("one undo step, replicated", s.undo_depth - depth == 1 and backend._repl_durable.has("/vca/1"))
	DAW.set_vca(1, 40.0)
	close_to("clamped to +12 dB", s.vca_db(1), 12.0, 0.001)
	DAW.set_vca(9, 3.0)
