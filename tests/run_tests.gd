	check("and its head burns brighter (%.2f over %.2f)" % [m._heads.colour_of(pin.slot).v, quiet], m._heads.colour_of(pin.slot).v > quiet * 1.5)
	s.send(3, 1).volume = 0.0
	m._pulse(0.0)
