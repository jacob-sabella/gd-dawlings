func _test_a_send_can_be_taken_before_the_fader() -> void:
	var backend := _offline()
	var s := DAW.state
	var verb := 13
	var sd := s.send(3, 1, false)
	check("the snare sends to the return, after its fader", sd != null and not sd.pre_fader)
	backend._repl_durable.clear()
	DAW.set_send_pre_fader(3, 1, true)
	check("set_send_pre_fader takes it before", sd.pre_fader)
	check("and replicates it on the send's own address", backend._repl_durable.has("/track/3/send/1/pre"))
	var guest := MixState.new()
	MixWire.apply_replicated(guest, MixWire.snapshot(s))
	check("a guest joining later reads it in the snapshot", guest.send(3, 1, false) != null
			and guest.send(3, 1).pre_fader)
	DAW.undo()
	check("one undo step puts it back after", not sd.pre_fader)
	DAW.set_send_pre_fader(2, 4, true)
	check("a send that is not there is not made", s.send(2, 4, false) == null)
	check("a guest may ask for it", &"set_send_pre_fader" in DAW.COMMANDS)
	DAW.apply_intent(&"set_send_pre_fader", [3, 1, 1.0])
	check("and its ask is heard", sd.pre_fader)
	DAW.apply_intent(&"set_send_pre_fader", [3, 0, 0.0])
	check("a malformed one is not", sd.pre_fader)
	DAW.set_send_pre_fader(3, 1, false)

	# Reaper: I_SENDMODE through the bridge, reported back by the structure poll.
	var link := _fresh_link()
	link._on_structure({"tracks": [{"index": 4, "sends": [{"index": 0, "dest_track": 26,
			"dest_name": "Verb Rtn", "pre": true}]}], "track_count": 40})
	check("the bridge says which sends are pre-fader", link.state.send(4, 1).pre_fader)
	link.free()

	# The desk: a PRE button on each strip while the sends are on the faders.
	var console := ConsoleSurface.new()
	add_child(console)
	console._process(0.0)
	var by_track := {}
	for strip in console.strips:
		by_track[strip.track_index] = strip
	var snare: ChannelStrip = by_track[3]
	var kick: ChannelStrip = by_track[2]
	check("no PRE button while the faders are the tracks'", not snare.pre.visible and snare.pre.collision_layer == 0)
	console.cycle_sends()
	check("flipped, the snare's PRE is there and dark", console.send_dest == verb and snare.pre.visible
			and snare.pre.collision_layer != 0 and not snare.pre.lit)
	check("and a strip with no send has none", not kick.pre.visible and kick.pre.collision_layer == 0)
	snare.pre.pressed.emit()
	check("pressed, the send is pre-fader and the button lit", sd.pre_fader and snare.pre.lit)
	check("its card says so (%s)" % snare.pre.title(), snare.pre.title() == "SNARE  SEND TO VERB RTN  PRE-FADER")
	snare.pre.pressed.emit()
	check("pressed again, post", not sd.pre_fader and not snare.pre.lit)
	console.free()

	# Saved: a project written and read back keeps it.
	DAW.set_send_pre_fader(3, 1, true)
	var p := ProjectBridge.capture(backend)
	check("the project's send is pre-fader", p.track("t3").sends.size() == 1 and p.track("t3").sends[0].pre_fader)
	var fresh := OfflineBackend.new()
	fresh.state = MixState.new()
	DAW.use(fresh)
	var refused := ProjectBridge.load(p, fresh)
	check("and loaded, it still is (%s)" % [refused], refused.is_empty() and DAW.state.send(3, 1, false) != null
			and DAW.state.send(3, 1).pre_fader)
	_offline()


func _test_quantise_can_swing() -> void:
	close_to("straight, an off-beat eighth stays put", DAWBackend.swung_grid_beat(0.5, 0.5, 0.0), 0.5)
	close_to("fully swung, it is a triplet's third", DAWBackend.swung_grid_beat(0.52, 0.5, 1.0), 2.0 / 3.0)
	close_to("half swung, between", DAWBackend.swung_grid_beat(0.6, 0.5, 0.5), 0.5 + 0.5 / 6.0)
	close_to("an on-beat never moves", DAWBackend.swung_grid_beat(1.03, 0.5, 1.0), 1.0)
	close_to("a late swung note is still its own off-beat, not the next beat",
			DAWBackend.swung_grid_beat(0.8, 0.5, 1.0), 2.0 / 3.0)

	_offline()
	var s := DAW.state
	var lane := 6
	s.track(lane).items.clear()
	var beat := 60.0 / s.tempo
	# Straight eighths, played a hair off.
	DAW.insert_midi_take(lane, 4.0 * beat, 6.0 * beat, [[4.0 * beat + 0.01, 4.4 * beat, 60, 100, 0],
			[4.5 * beat + 0.01, 4.9 * beat, 62, 100, 0], [5.0 * beat - 0.01, 5.4 * beat, 64, 100, 0],
			[5.5 * beat, 5.9 * beat, 65, 100, 0]], "Keys")
	var depth := maxi(s.undo_depth, 0)
	DAW.quantize_item(lane, 0, 0.5, 1.0, 1.0)
	var notes := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	var ons: Array = notes.map(func(n): return n[0] / beat)
	check("swung, the off-beats land a third late and the beats on the beat (%s)" % [ons],
			absf(ons[0] - 4.0) < 1e-3 and absf(ons[1] - (4.5 + 1.0 / 6.0)) < 1e-3
			and absf(ons[2] - 5.0) < 1e-3 and absf(ons[3] - (5.5 + 1.0 / 6.0)) < 1e-3)
	check("one undo step", s.undo_depth - depth == 1)
	DAW.undo()
	DAW.apply_intent(&"quantize_item", [lane, 0, 0.5, 1.0, 9.0])
	notes = MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	check("a guest's swing is held to full (%.4f)" % (notes[1][0] / beat), absf(notes[1][0] / beat - (4.5 + 1.0 / 6.0)) < 1e-3)
	DAW.undo()
	DAW.apply_intent(&"quantize_item", [lane, 0, 0.5, 1.0])
	check("and the old four-word ask is refused", s.undo_depth - depth == 0)

	# On the timeline: a rail on the ITEM page beside QUANTISE, for a MIDI item.
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	check("the item page has a swing rail with its mark", page.swing != null and page.swing.glyph == &"swing"
			and page.controls().find(page.swing) == page.controls().find(page.quant) + 1)
	check("out of reach with nothing selected", not page.swing.available)
	DAW.select_item(lane, 0, false)
	page.refresh()
	check("in reach for a MIDI item", page.swing.available)
	page.swing.value = 1.0
	check("QUANTISE's card says it swings (%s)" % page._quant_text(), page._quant_text().ends_with("swung 100%"))
	page.quant.pressed.emit()
	notes = MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	check("pressed, the beat grid is swung: the note on the off-beat a third of a beat late (%.3f)" % (notes[2][0] / beat),
			absf(notes[2][0] / beat - (5.0 + 1.0 / 3.0)) < 1e-3 and absf(notes[0][0] / beat - 4.0) < 1e-3)
	DAW.undo()
	DAW.select_item(2, 0, false)
	page.refresh()
	check("and out of reach for an audio item", not page.swing.available)
	DAW.clear_item_selection()
	timeline.free()


func _test_a_render_is_written_at_a_chosen_depth() -> void:
	_offline()
	check("three depths, 24-bit the usual", DAW.RENDER_BITS == [16, 24, 32] and DAW.RENDER_BITS_DEFAULT == 24)
	# A guest's ask, as the host takes it: the depth kept when it is one of the three, the usual
	# one when it is not, and an ask from before depths (one word) still a render.
	var spy := RenderSpy.new()
	spy.state = DAW.state
	DAW.use(spy)
	DAW.apply_intent(&"render", [1.0, 16.0])
	DAW.apply_intent(&"render", [0.0, 12.0])
	DAW.apply_intent(&"render", [1.0])
	DAW.apply_intent(&"render", [1.0, NAN])
	check("the host renders a guest's depth, or 24 (%s)" % [spy.asked],
			spy.asked == [[true, 16], [false, 24], [true, 24], [true, 24]])

	# The RENDER page: a token stepping round the depths, its mark the depth, sent with the render.
	_offline()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineRenderPage = timeline.render_page
	check("the render page has a depth token at 24-bit", page.depth != null and page.bits == 24
			and page.depth.glyph == &"depth_24" and page.depth.lit)
	page.depth.pressed.emit()
	check("pressed, 32-bit float, and its mark a smooth wave", page.bits == 32 and page.depth.glyph == &"depth_32")
	page.depth.pressed.emit()
	check("again, 16-bit, in coarse steps", page.bits == 16 and page.depth.glyph == &"depth_16")
	check("MIX's card says the depth (%s)" % page._what(false), page._what(false).contains("16-bit WAV, dithered")
			or page._what(false).contains("cannot render"))
	spy = RenderSpy.new()
	spy.state = DAW.state
	DAW.use(spy)
	page.busy = false
	page._render(true)
	check("and a render from the page carries it (%s)" % [spy.asked], spy.asked == [[true, 16]])
	timeline.free()
	_offline()


func _test_a_render_has_a_sample_rate() -> void:
	_offline()
	check("three rates, 48 kHz the usual", DAW.RENDER_RATES == [44100, 48000, 96000] and DAW.RENDER_RATE_DEFAULT == 48000)
	var spy := RenderSpy.new()
	spy.state = DAW.state
	DAW.use(spy)
	DAW.apply_intent(&"render", [1.0, 24.0, 0.0, 44100.0])
	DAW.apply_intent(&"render", [0.0, 16.0, 0.0, 22050.0])
	DAW.apply_intent(&"render", [0.0, 16.0, 0.0, NAN])
	DAW.apply_intent(&"render", [1.0, 24.0])
	check("the host renders a guest's rate, or 48 kHz (%s)" % [spy.asked],
			spy.asked == [[true, 24, 44100], [false, 16], [false, 16], [true, 24]])
	# One second of 48 kHz comes out as 44100 frames at 44.1 and 96000 at 96.
	var second := PackedVector2Array()
	second.resize(48000)
	check("resampled to 44.1 kHz, a second is 44100 frames", absi(Resampler.new().resample(second, 48000.0, 44100.0).size() - 44100) <= 2)
	check("resampled to 96 kHz, a second is 96000", absi(Resampler.new().resample(second, 48000.0, 96000.0).size() - 96000) <= 2)
	_offline()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineRenderPage = timeline.render_page
	check("the render page has a rate token at 48 kHz", page.rate_key != null and page.rate == 48000
			and page.rate_key.glyph == &"rate_48" and page.rate_key.lit)
	page.rate_key.pressed.emit()
	check("pressed, 96 kHz, its mark dense", page.rate == 96000 and page.rate_key.glyph == &"rate_96")
	page.rate_key.pressed.emit()
	check("again, 44.1 kHz", page.rate == 44100 and page.rate_key.glyph == &"rate_44" and TimelineRenderPage.rate_name(44100) == "44.1 kHz")
	spy = RenderSpy.new()
	spy.state = DAW.state
	DAW.use(spy)
	page.busy = false
	page._render(false)
	check("and a render from the page carries it (%s)" % [spy.asked], spy.asked == [[false, 24, 44100]])
	timeline.free()
	_offline()


func _test_a_render_can_be_normalised() -> void:
	var quiet := PackedVector2Array([Vector2(0.1, -0.25), Vector2(0.05, 0.2)])
	close_to("a quiet mix is brought up to a peak a decibel under full scale",
			MixRender.normalise_gain(quiet) * 0.25, db_to_linear(-1.0))
	var hot := PackedVector2Array([Vector2(1.6, 0.0)])
	check("one over full scale comes down", MixRender.normalise_gain(hot) < 1.0)
	check("silence is left alone", MixRender.normalise_gain(PackedVector2Array([Vector2.ZERO])) == 1.0)

	_offline()
	var spy := RenderSpy.new()
	spy.state = DAW.state
	DAW.use(spy)
	DAW.apply_intent(&"render", [1.0, 24.0, 1.0])
	DAW.apply_intent(&"render", [0.0, 16.0, 0.0])
	DAW.apply_intent(&"render", [0.0, 16.0])
	check("the host renders a guest's normalised ask, and one without the word plain (%s)" % [spy.asked],
			spy.asked == [[true, 24, true], [false, 16], [false, 16]])

	_offline()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineRenderPage = timeline.render_page
	var key := page.normalise_key
	check("the render page has a normalise token, off", key != null and key.glyph == &"normalise"
			and not page.normalise and not key.lit)
	key.pressed.emit()
	check("pressed, on and lit", page.normalise and key.lit)
	check("MIX's card says so (%s)" % page._what(false), page._what(false).contains("normalised to -1 dB")
			or page._what(false).contains("cannot render"))
