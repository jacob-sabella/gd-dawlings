	check("the verb crosses the wire as an item edit", DAW.ITEM_EDITS.has(&"staccato_item") and &"staccato_item" in DAW.COMMANDS)


func _test_notes_are_made_legato() -> void:
	_offline()
	var s := DAW.state
	var lane := 6
	s.track(lane).items.clear()
	var beat := 60.0 / s.tempo
	# A chord of two, a short note, a long one that overlaps the last, and the last.
	var played: Array = [[4.0 * beat, 4.2 * beat, 60, 100, 0], [4.0 * beat, 4.2 * beat, 64, 100, 0],
			[5.0 * beat, 5.1 * beat, 62, 90, 0], [6.0 * beat, 8.0 * beat, 65, 80, 0], [7.0 * beat, 7.5 * beat, 67, 70, 0]]
	DAW.insert_midi_take(lane, 4.0 * beat, 8.0 * beat, played, "Legato")
	var item: MixState.ItemState = s.item(lane, 0)
	var depth := maxi(s.undo_depth, 0)
	DAW.legato_item(lane, 0)
	var n := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	n.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[2] < b[2]))
	check("a chord's notes all run to the next start (%.2f, %.2f beats)" % [(n[0][1] - n[0][0]) / beat, (n[1][1] - n[1][0]) / beat],
			is_equal_approx(n[0][1], 5.0 * beat) and is_equal_approx(n[1][1], 5.0 * beat))
	check("a short note is held to the next", is_equal_approx(n[2][1], 6.0 * beat))
	check("an overlapping one is cut back to it", is_equal_approx(n[3][1], 7.0 * beat))
	check("the last keeps its length", is_equal_approx(n[4][1], 7.5 * beat))
	check("pitches and velocities are as played", int(n[2][2]) == 62 and int(n[3][3]) == 80 and s.undo_depth - depth == 1)
	DAW.legato_item(lane, 0)
	check("done again, it is no edit", s.undo_depth - depth == 1)
	DAW.undo()
	var back := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	back.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[2] < b[2]))
	check("undone, the notes are as played", is_equal_approx(back[2][1], 5.1 * beat))
	DAW.set_item_locked(lane, 0, true)
	DAW.legato_item(lane, 0)
	var locked_depth := s.undo_depth
	DAW.legato_item(lane, 0)
	check("a locked item is left alone", s.undo_depth == locked_depth)
	DAW.set_item_locked(lane, 0, false)
	check("a guest may ask", &"legato_item" in DAW.COMMANDS)
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	DAW.select_item(lane, 0, false)
	timeline.item_page.refresh()
	check("a LEGATO token on the item page, lit for a MIDI item", timeline.item_page.legato != null
			and timeline.item_page.legato.glyph == &"legato" and timeline.item_page.legato.lit)
	timeline.item_page.legato.pressed.emit()
	var pressed := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	pressed.sort_custom(func(a, b): return a[0] < b[0] or (a[0] == b[0] and a[2] < b[2]))
	check("pressed, the notes are held", is_equal_approx(pressed[2][1], 6.0 * beat))
	DAW.clear_item_selection()
	timeline.free()


func _test_notes_are_humanised() -> void:
	_offline()
	var s := DAW.state
	var lane := 6
	s.track(lane).items.clear()
	var beat := 60.0 / s.tempo
	var played: Array = []
	for k in 16:
		played.append([(4.0 + k * 0.5) * beat, (4.4 + k * 0.5) * beat, 60, 100, 0])
	DAW.insert_midi_take(lane, 4.0 * beat, 12.0 * beat, played, "Keys")
	var before := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	var depth := maxi(s.undo_depth, 0)
	DAW.humanise_item(lane, 0, 0.02, 10)
	var after := MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	var moved := 0
	var louder_or_softer := 0
	var within := true
	var lengths := true
	for k in after.size():
		var d: float = after[k][0] - before[k][0]
		moved += 1 if absf(d) > 1e-6 else 0
		louder_or_softer += 1 if int(after[k][3]) != 100 else 0
		within = within and absf(d) <= 0.02 + 1e-6 and absi(int(after[k][3]) - 100) <= 10
		lengths = lengths and absf((after[k][1] - after[k][0]) - (before[k][1] - before[k][0])) < 1e-6
	check("humanised, most notes moved and changed (%d moved, %d velocities)" % [moved, louder_or_softer],
			moved >= 12 and louder_or_softer >= 8)
	check("none further than asked, each keeping its length", within and lengths)
	check("none before its item's start", after.all(func(n): return n[0] >= s.item(lane, 0).start - 1e-6))
	check("one undo step", s.undo_depth - depth == 1)
	var first: PackedFloat32Array = s.item(lane, 0).notes
	DAW.undo()
	DAW.humanise_item(lane, 0, 0.02, 10)
	check("the same notes humanise the same way: the host's edit is one answer", s.item(lane, 0).notes == first)
	DAW.humanise_item(lane, 0, 0.02, 10)
	check("and pressed again, differently", s.item(lane, 0).notes != first)
	DAW.undo()
	DAW.undo()
	check("a guest may ask", &"humanise_item" in DAW.COMMANDS)
	DAW.apply_intent(&"humanise_item", [lane, 0, 5.0, 999])
	after = MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start)
	check("a guest's amounts are held to the most (%.3f)" % absf(after[3][0] - before[3][0]),
			after.all(func(n): return absi(int(n[3]) - 100) <= DAWBackend.HUMANISE_VELOCITY_MAX))
	DAW.undo()
	DAW.set_item_locked(lane, 0, true)
	DAW.humanise_item(lane, 0, 0.02, 10)
	check("a locked item is not humanised", MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start) == before)
	DAW.set_item_locked(lane, 0, false)

	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var page: TimelineItemPage = timeline.item_page
	DAW.select_item(lane, 0, false)
	page.refresh()
	check("a HUMANISE token on the item page, lit for a MIDI item", page.humanise != null
			and page.humanise.glyph == &"humanise" and page.humanise.lit)
	page.humanise.pressed.emit()
	check("pressed, the notes move", MidiTake.unpack_relative(s.item(lane, 0).notes, s.item(lane, 0).start) != before)
	DAW.undo()
	check("a NOTE VELOCITY rail on the item page, within reach for a MIDI item", page.note_velocity != null
			and page.note_velocity.glyph == &"note_velocity" and page.note_velocity.available)
	DAW.seek(s.item(lane, 0).start + s.item(lane, 0).notes[0] + 0.001)
	page.refresh()
	var nv_was := int(s.item(lane, 0).notes[3])
	page.note_velocity.value_committed.emit(1.0)
	check("let go, the note at the playhead takes that velocity", int(s.item(lane, 0).notes[3]) == 127 and nv_was != 127 or nv_was == 127)
	DAW.undo()
	DAW.clear_item_selection()
	timeline.free()


func _test_an_items_sound_is_stretched_and_shifted() -> void:
	var backend := GodotBackend.new()
	backend.state = MixState.new()
	DAW.use(backend)
	var s := DAW.state
	var take := AudioTake.create("suite-stretch-take.wav")
	var tone := PackedVector2Array()
	tone.resize(AudioTake.RATE / 2)
	for i in tone.size():
		tone[i] = Vector2.ONE * 0.5 * sin(TAU * 440.0 * i / AudioTake.RATE)
	take.append(AudioTake.encode(tone))
	take.finish()
	var lane := 6
	s.track(lane).items.clear()
	DAW.insert_audio_take(lane, 300.0, take.file_name(), take.seconds(), take.peaks(), "Grace audio 1")
	var old: MixState.ItemState = s.item(lane, 0)
	var old_source := old.source
	var length := old.length
	var depth := maxi(s.undo_depth, 0)
	DAW.process_item(lane, 0, DAWBackend.PROCESS_STRETCH, 2.0)
	var it: MixState.ItemState = s.item(lane, 0)
	check("stretched: the item plays a new file", it.source != old_source and FileAccess.file_exists(backend.media_path(it.source)))
	close_to("twice as long", it.length, length * 2.0, 0.001)
	check("in one step", s.undo_depth - depth == 1)
	var heard := DawKitAudioFile.read(backend.media_path(it.source))
	close_to("and the file is that long", float(heard["frames"]) / float(heard["rate"]), length * 2.0, 0.05)
	DAW.process_item(lane, 0, DAWBackend.PROCESS_PITCH, 12.0)
	var up: MixState.ItemState = s.item(lane, 0)
	close_to("an octave up keeps the length", up.length, length * 2.0, 0.001)
	check("in a file of its own", up.source != it.source and backend.take_peaks.has(up.source))
	DAW.undo()
	DAW.undo()
	check("undone, the old file and length are back", s.item(lane, 0).source == old_source and is_equal_approx(s.item(lane, 0).length, length))
	check("a guest may ask", &"process_item" in DAW.COMMANDS and &"process_item" in DAW.LOCKED_REFUSES)
	_as_session(Session.Role.HOST, 1)
	DAW.apply_intent(&"process_item", [lane, 0, 0, 100.0])
	close_to("a wild ratio from a peer is held to four times", s.item(lane, 0).length, length * 4.0, 0.001)
	DAW.undo()
	_offline()
	DAW.set_item_locked(lane, 0, true)
	DAW.process_item(lane, 0, DAWBackend.PROCESS_STRETCH, 2.0)
	check("a locked item is left alone", s.item(lane, 0).source == old_source)
	DAW.set_item_locked(lane, 0, false)
	DAW.insert_midi_take(lane, 320.0, 322.0, [[320.0, 320.5, 60, 100, 0]], "Keys")
	var midi_index := s.track(lane).items.size() - 1
	var midi_length := s.item(lane, midi_index).length
	DAW.process_item(lane, midi_index, DAWBackend.PROCESS_STRETCH, 2.0)
	check("and a MIDI item has no sound to stretch", is_equal_approx(s.item(lane, midi_index).length, midi_length))
	for f in [backend.media_path(it.source), backend.media_path(up.source)]:
		DirAccess.remove_absolute(f)


func _test_a_rig_roll_is_planned_from_its_settings() -> void:
	var wild := RollSettings.from_dict({"count": 99, "pool": 7, "key_locked": true, "seed": -4})
	check("settings are held to their limits", wild.count == RollSettings.COUNT_MAX and wild.pool == RollSettings.Pool.CUSTOM
			and wild.key_locked and wild.seed_value == 0)
	check("and round-trip", RollSettings.from_dict(wild.to_dict()).to_dict() == wild.to_dict())
	var catalogue := []
	for k in [&"eq", &"compressor", &"reverb", &"delay", &"chorus", &"filter", &"distortion", &"phaser", &"limiter"]:
		catalogue.append([k, String(k)])
	var drawn := func(pool: RollSettings.Pool) -> Array:
		var ps := RollSettings.new()
		ps.pool = pool
		return RigRoll.pool_of(ps, catalogue, true).map(func(c): return String(c[0]))
	check("TIME-BASED draws only delay, reverb, chorus, phaser", drawn.call(RollSettings.Pool.TIME_BASED) == ["reverb", "delay", "chorus", "phaser"])
	check("DIRTY draws only drive, low-pass, compressor", drawn.call(RollSettings.Pool.DIRTY) == ["compressor", "filter", "distortion"])
	check("EVERYTHING is all of it, CHARACTER the five", drawn.call(RollSettings.Pool.EVERYTHING).size() == 9
			and drawn.call(RollSettings.Pool.CHARACTER).size() == 5)
	var only_dirty := RollSettings.new()
	only_dirty.pool = RollSettings.Pool.DIRTY
	only_dirty.seed_value = 7
	var plan := RigRoll.plan(only_dirty, RigRoll.rng_for(only_dirty), [0, 1, 2], RigRoll.pool_of(only_dirty, catalogue, true))
	check("a DIRTY roll lands only dirty pedals", plan["pedals"].all(func(p): return ["compressor", "filter", "distortion"].has(str(p["plugin"]))))
	check("junk falls back to the defaults", RollSettings.from_dict({"count": "x"}).count >= RollSettings.COUNT_MIN)
	var s := RollSettings.new()
	s.count = 3
	s.seed_value = 4242
	var choices := [["distortion", "Drive"], ["eq", "EQ"], ["reverb", "Room"], ["limiter", "Limit"], ["delay", "Echo"]]
	var pool := RigRoll.pool_of(s, choices, true)
	check("a character pool leaves out the utility kinds", pool.size() == 3 and pool.all(func(c): return c[0] != "eq" and c[0] != "limiter"))
	check("everything, or a list with no kinds, keeps all", RigRoll.pool_of(s, choices, false).size() == 5)
	var tracks := [0, 1, 2, 3, 4]
	var one := RigRoll.rng_for(s)
	var n := RigRoll.track_count(one)
	var a := RigRoll.plan(s, one, tracks.slice(0, n), pool)
	var two := RigRoll.rng_for(s)
	RigRoll.track_count(two)
	var b := RigRoll.plan(s, two, tracks.slice(0, n), pool)
	check("the same seed lands the same roll", a == b and n >= RollSettings.TRACKS_MIN and n <= RollSettings.TRACKS_MAX)
	var landed: Array = a["pedals"]
	check("three pedals on three different tracks", landed.size() == 3 and landed.map(func(p): return p["track"]).size() == 3
			and landed.map(func(p): return p["track"]).filter(func(t): return t in tracks).size() == 3
			and landed.map(func(p): return p["track"]).duplicate().size() == 3)
	var distinct := {}
	for p in landed:
		distinct[p["track"]] = true
	check("distinct", distinct.size() == 3)
	check("and a key is named", not str(a["key"]).is_empty())
	s.key_locked = true
	check("a locked key is not rolled", RigRoll.plan(s, RigRoll.rng_for(s), tracks, pool)["key"] == "")
	check("an empty pool lands nothing", RigRoll.plan(s, RigRoll.rng_for(s), tracks, [])["pedals"].is_empty())


func _test_the_band_goes_into_the_roulette_room_and_back() -> void:
	var saved_layout := Session.layout
	Session.layout = LayoutProfile.new()
	Session.layout.save_path = "user://test_layout_profile_roulette.cfg"
	DAW.use(OfflineBackend.new())
	var studio := Studio.new()
	studio.medium = Presentation.Medium.SCREEN
	add_child(studio)
	for surface in studio.focus.surfaces:
		surface._process(0.0)
	check("the room is a place the game knows, and not one of the venues", Venue.is_known(Venue.ROULETTE_ID)
			and not Venue.IDS.has(Venue.ROULETTE_ID))
	check("cycling never lands in it", Venue.IDS.all(func(v: StringName) -> bool: return Venue.next_after(v) != Venue.ROULETTE_ID))
	check("leaving when not in it does nothing", not studio.leave_roulette_room())
	studio.choose_venue(&"grid", 1)
	var poses := {}
	for surface in studio.focus.surfaces:
		poses[surface.surface_id] = surface.global_transform
	check("the host goes in", studio.enter_roulette_room() and studio.in_roulette_room())
	check("it is the roulette room (%s)" % studio.venue.title(), studio.venue is RouletteRoom
			and studio.venue.venue_id() == Venue.ROULETTE_ID and studio.venue.title() == "Rig Roulette room")
	check("and is not written down as the room's venue", Session.layout.venue == &"grid" and Session.layout.venue_variant == 1)
	check("the room the host publishes names it", studio.room_state()["venue"] == Venue.ROULETTE_ID)
	var moved := []
	for surface in studio.focus.surfaces:
		if surface.surface_id != &"levels" and surface.surface_id != &"tv" \
				and not surface.global_transform.is_equal_approx(poses[surface.surface_id]):
			moved.append(surface.surface_id)
	check("no gear moved, LEVELS and the TV aside, which are on the room's wall (%s)" % [moved], moved.is_empty())
	check("the setup wall stands in it, and the board", studio.rig_roulette_station != null and studio.roll_board != null)
	var wall := studio.rig_roulette_station
	wall.count = 3
	wall.key_locked = true
	wall.changed.emit()
	check("the studio keeps what the wall is set to", studio.roll_settings.count == 3 and studio.roll_settings.key_locked)
	check("going in twice does nothing", not studio.enter_roulette_room())
	var room := studio.venue as RouletteRoom
	var walls := room.get_children().filter(func(n): return String(n.name).ends_with("Wall"))
	check("it is shut in by walls", walls.size() >= 2 and room.find_child("Ceiling", false, false) != null)
	for i in 12:
		room.pulse(0.9)
	var spun := room._spin
	room._process(0.5)
	check("a loud mix turns the wheel", room.heard > 0.7 and room._spin != spun)
	check("everything the band shares stands inside its walls", absf(room.prop_shelf_spot().origin.x) < room.room_width * 0.5
			and absf(room.hoop_spot().origin.x) < room.room_width * 0.5 and absf(room.tour_case_spot().origin.x) < room.room_width * 0.5)
	studio.set_venue(&"nowhere", false)
	check("an unknown venue is still the studio", studio.venue.venue_id() == &"studio")
	studio.enter_roulette_room()
	check("and the way out goes back to where the band was (%s)" % studio.venue.venue_id(),
			studio.leave_roulette_room() and studio.venue.venue_id() == &"studio" and not studio.in_roulette_room())
	studio.choose_venue(&"grid", 1)
	studio.enter_roulette_room()
	studio.leave_roulette_room()
	check("the venue and its arrangement come back", studio.venue.venue_id() == &"grid" and studio.venue.variant == 1)
	check("the setup wall stays behind in the room", studio.rig_roulette_station == null)
	studio.enter_roulette_room()
	check("and is set as it was left", studio.rig_roulette_station.count == 3 and studio.rig_roulette_station.key_locked)
	studio.leave_roulette_room()
	studio.queue_free()
	Session.layout = saved_layout


