	check("a fix ticks the line and the tag without a signal (%s / %s)" % [first.text, hud._tag.text],
			first.text.begins_with("OK ") and hud._tag.text == "BAND OF 3   1 / 1 FIXED")

	run.flaws = [&"wrong_tempo", &"hard_pan"]
