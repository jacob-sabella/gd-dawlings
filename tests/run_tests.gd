			and absi(wav.data.decode_s16(wav.data.size() - 2)) < 4)

	# The tab: its number, and the note it rings now, changing at the chord change.
	var now := [am]
	InstrumentItem.clock = func() -> float: return now[0]
	for bell in bells:
