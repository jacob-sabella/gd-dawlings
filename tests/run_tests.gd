func _test_the_clip_editor_fades_and_gain_are_one_undo_step_each() -> void:
	_offline()
	DAW.transport_stop()
	var s := DAW.state
	var path := _clip_take_on_kick("clip_fade_take.wav", [0.731, 2.013])
	var editor := _clip_editor_on(2, 0)
	var it := s.item(2, 0)
	var start := it.start
	var attack := editor.attacks()[0]
	var hand := FakeHand.new()
	add_child(hand)
	var depth := s.undo_depth
	check("the top of the start edge is the fade in's corner", editor.handle_at(editor.to_local(_clip_at(editor, start, NAN))) == ClipEditorSurface.FADE_IN)
	editor._face.grab_begin(hand, _clip_at(editor, start, NAN))
	editor._face.grab_move(hand, _clip_at(editor, attack + 0.003, NAN))
	check("dragged, the fade is drawn to the attack near it, not yet made (%s)" % [editor.preview],
			absf(float(editor.preview.get("fade_in", 0.0)) - (attack - start)) < 0.0005 and is_zero_approx(s.item(2, 0).fade_in))
	editor._face.grab_end(hand)
	close_to("let go, the clip fades in to the attack", s.item(2, 0).fade_in, attack - start, 0.0005)
	check("in one undo step, the start and the fade out untouched", s.undo_depth == depth + 1
			and is_equal_approx(s.item(2, 0).start, start) and is_zero_approx(s.item(2, 0).fade_out))
	editor.set_snapping(false)
	var end := s.item(2, 0).end()
	_clip_drag(editor, hand, _clip_at(editor, end, NAN), _clip_at(editor, end - 0.3141, NAN))
	close_to("the end's top corner is the fade out, free to the millisecond", s.item(2, 0).fade_out, 0.3141, 0.0002)
	check("one more step", s.undo_depth == depth + 2)
	editor.set_snapping(true)
	# The gain line: up a sixth of the half height is six decibels.
	var middle := (start + end) * 0.5
	var up := (editor.gain_y(0.0) - ClipEditorSurface.WAVE_MID) / ClipEditorSurface.WAVE_HALF
	check("the gain line is where the press is", editor.handle_at(editor.to_local(editor.point_for(middle, up))) == ClipEditorSurface.GAIN)
	var per := 1.0 / (ClipEditorSurface.GAIN_HIGH - ClipEditorSurface.GAIN_LOW)
	_clip_drag(editor, hand, editor.point_for(middle, up), editor.point_for(middle, up + 6.0 * per))
	close_to("dragged up, the clip is 6 dB louder", s.item(2, 0).gain_db, 6.0, 0.05)
	editor._redraw()
	check("in one step, and the readout says so (%s)" % editor.readouts()[5], s.undo_depth == depth + 3
			and editor.readouts()[5] == "+6.0 dB")
	hand.holding_shift = true
	var at_six := (editor.gain_y(6.0) - ClipEditorSurface.WAVE_MID) / ClipEditorSurface.WAVE_HALF
	_clip_drag(editor, hand, editor.point_for(middle, at_six), editor.point_for(middle, at_six - 6.0 * per))
	hand.holding_shift = false
	close_to("fine, the same drag down is a tenth as far", s.item(2, 0).gain_db, 5.4, 0.05)
	DAW.undo()
	DAW.undo()
	close_to("undone twice, the gain is back", s.item(2, 0).gain_db, 0.0)
	# Locked, nothing moves, and the panel says why.
	DAW.set_item_locked(2, 0, true)
	depth = s.undo_depth
	var fade := s.item(2, 0).fade_in
	_clip_drag(editor, hand, _clip_at(editor, start), _clip_at(editor, start + 0.2))
	editor.key(&"plus_10").pressed.emit()
	editor._redraw()
	check("a locked clip is not trimmed, faded or nudged here (%s)" % editor.message_text(), s.undo_depth == depth
			and is_equal_approx(s.item(2, 0).start, start) and is_equal_approx(s.item(2, 0).fade_in, fade)
			and editor.message_text().contains("LOCKED") and not editor.key(&"plus_10").available)
	DAW.set_item_locked(2, 0, false)
	_clip_cleanup(editor, hand, path)


func _test_the_clip_editor_puts_edges_on_zero_crossings() -> void:
	_offline()
	DAW.transport_stop()
	var s := DAW.state
	# Two seconds of a 110 Hz sine: a crossing every 4.5 ms, and between them nothing near zero.
	var name := "clip_sine_take.wav"
	var path := ProjectSettings.globalize_path(AudioTake.DIR.path_join(name))
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var samples := PackedFloat32Array()
	samples.resize(96000)
	for n in samples.size():
		samples[n] = 0.5 * sin(TAU * 110.0 * n / 48000.0)
	DawKitAudioFile.write_wav(path, samples, 1, 48000)
	ClipWave.forget()
	var sound := ClipWave.of_file(path)
	var item := s.item(2, 0)
	item.source = name
	item.source_offset = 0.1
	DAW.trim_item(2, 0, item.start, item.start + 1.5)
	var editor := _clip_editor_on(2, 0)
	editor.set_snapping(false)
	var start := item.start
	var hand := FakeHand.new()
	add_child(hand)
	editor.set_view(start - 0.02, 0.1)
	var aimed := start + 0.0123
	_clip_drag(editor, hand, _clip_at(editor, start), _clip_at(editor, aimed))
	var heard := ClipWave.sample_at(sound, ClipEditorSurface.file_time(s.item(2, 0), s.item(2, 0).start))
	check("ZERO X off, the edge is where it was let go, mid-wave (%.3f)" % heard,
			absf(s.item(2, 0).start - aimed) < 0.0001 and absf(heard) > 0.2)
	DAW.undo()
	editor.key(&"zero").pressed.emit()
	check("the ZERO X key is lit, and its card says what it does", editor.zero_crossings and editor.key(&"zero").lit
			and editor.key(&"zero").hint().contains("zero crossing"))
	_clip_drag(editor, hand, _clip_at(editor, start), _clip_at(editor, aimed))
	heard = ClipWave.sample_at(sound, ClipEditorSurface.file_time(s.item(2, 0), s.item(2, 0).start))
	check("on, the edge lands on the sound's nearest zero crossing (%.5f, %.2f ms away)" % [heard, (s.item(2, 0).start - aimed) * 1000.0],
			absf(heard) < 0.005 and absf(s.item(2, 0).start - aimed) <= ClipEditorSurface.ZERO_REACH)
	editor.fit()
	var end := s.item(2, 0).end()
	_clip_drag(editor, hand, _clip_at(editor, end), _clip_at(editor, end - 0.0571))
	heard = ClipWave.sample_at(sound, ClipEditorSurface.file_time(s.item(2, 0), s.item(2, 0).end()))
	check("and so does the end (%.5f)" % heard, absf(heard) < 0.005 and s.item(2, 0).end() < end - 0.05)
	_clip_cleanup(editor, hand, path)


func _test_the_clip_editor_is_opened_retargeted_and_closed() -> void:
	_offline()
	DAW.transport_stop()
	var s := DAW.state
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var editor := ClipEditorSurface.new()
	add_child(editor)
	timeline.edit_asked.connect(editor.open)
	var lanes: TimelineLanes = timeline._lanes
	var it := s.item(2, 0)
	timeline.set_view(it.start - 1.0, it.length + 2.0)
	var row := s.track_indices().find(2)
	var on_it := timeline.to_global(Vector3(timeline._x_for(it.start + it.length * 0.5), timeline._lane_y[row], lanes.position.z))
	var hand := FakeHand.new()
	add_child(hand)
	lanes.grab_begin(hand, on_it)
	lanes.grab_end(hand)
	check("one click on a clip selects it and opens nothing", s.item(2, 0).selected and not editor.is_open())
	lanes.grab_begin(hand, on_it)
	lanes.grab_end(hand)
	check("a second, straight after, opens it in the clip editor", editor.is_open() and editor.target == [2, 0])
	check("the lanes' card says so", lanes.hint().contains("double-click"))
	editor.close()
	hand.holding_shift = true
	lanes.grab_begin(hand, on_it)
	lanes.grab_end(hand)
	lanes.grab_begin(hand, on_it)
	lanes.grab_end(hand)
	hand.holding_shift = false
	check("two fine clicks are two edits of the selection, not a double click", not editor.is_open())
	# The item page's EDIT CLIP key, for a hand that does not double click: a MIDI clip, this time.
	var midi := []
	for t in s.track_indices():
		for i in s.track(t).items.size():
			if midi.is_empty() and not (s.track(t).items[i] as MixState.ItemState).notes.is_empty():
				midi = [t, i]
	DAW.select_item(midi[0], midi[1], false)
	var page: TimelineItemPage = timeline.item_page
	page.refresh()
	check("the item page has an EDIT CLIP key, lit for one selected item", page.edit_clip.glyph == &"clip_edit"
			and page.edit_clip.available and page.edit_clip.lit and page.edit_clip.readout().contains("clip editor"))
	page.edit_clip.pressed.emit()
	check("pressed, the editor opens on it", editor.is_open() and editor.target == midi)
	editor.open(2, 0)
	check("opening another retargets the one editor", editor.target == [2, 0])
	page.edit_clip.pressed.emit()
	check("and back", editor.target == midi and editor.is_midi())
	editor._redraw()
	check("a MIDI clip: no waveform, and the panel says what applies (%s)" % editor.message_text(),
			editor.message_text().contains("MIDI") and not editor.key(&"fade_in").available
			and not editor.key(&"zero").available and not editor.key(&"hit_on").available)
	var end := s.item(midi[0], midi[1]).end()
	editor.key(&"end").pressed.emit()
	editor.key(&"minus_10").pressed.emit()
	close_to("but its edges trim", s.item(midi[0], midi[1]).end(), end - 0.010, 0.00001)
	DAW.clear_item_selection()
	page.refresh()
	check("with nothing selected the key is out of reach", not page.edit_clip.available)
	var closed := [false]
	editor.closed.connect(func() -> void: closed[0] = true)
	editor.key(&"close").pressed.emit()
	check("CLOSE puts it away: hidden, out of the physics world, no controls left",
			closed[0] and not editor.is_open() and not editor.visible and editor.process_mode == Node.PROCESS_MODE_DISABLED
			and editor.find_children("*", "ControlAffordance", true, false).is_empty())
	editor.open(2, 0)
	DAW.project_replaced.emit()
	check("a project replaced closes it", not editor.is_open())
	hand.queue_free()
	editor.free()
	timeline.free()


## Every word on the editor lies on its face, read from the front -- the hover card's too: text
## goes on surfaces, never billboarded in the air.
func _test_the_clip_editors_lettering_lies_on_its_face() -> void:
	_offline()
	var editor := ClipEditorSurface.new()
	editor.rotation_degrees = Vector3(0, 30, 0)
	editor.scale = Vector3.ONE * 1.35
	add_child(editor)
	editor.open(2, 0)
	var normal := editor.global_basis.z.normalized()
	var labels := editor.find_children("*", "Label3D", true, false)
	var flat := true
	var why := ""
	for node in labels:
		var l := node as Label3D
		var z := editor.to_local(l.global_position).z
		if l.billboard != BaseMaterial3D.BILLBOARD_DISABLED or l.fixed_size or l.double_sided \
				or l.global_basis.z.normalized().dot(normal) < 0.999 or z < 0.0 or z > 0.015:
			flat = false
			why = "%s (z %.4f)" % [l.name, z]
	check("all %d words on it lie flat on its face, facing out %s" % [labels.size(), why], labels.size() > 20 and flat)
	var card := HoverCard.new()
	add_child(card)
	card.show_for(editor._face)
	var card_flat := true
	for node in card.find_children("*", "Label3D", true, false):
		var l := node as Label3D
		if l.billboard != BaseMaterial3D.BILLBOARD_DISABLED or l.global_basis.z.normalized().dot(normal) < 0.999:
			card_flat = false
	check("and its hover card prints on it too, in its plane", card.showing() == editor and card_flat
			and card.line_text().begins_with("CLIP EDITOR"))
	card.free()
	editor.free()


## In the studio: one editor, closed, hung by the timeline on its stand; opened by the timeline,
## under its lanes, in the seat's view, and clear of the rest of the room's gear by 0.6 m.
func _test_the_studio_hangs_the_clip_editor_by_the_timeline() -> void:
	var saved_layout := Session.layout
	var studio := _cassette_studio()
	await get_tree().process_frame
	await get_tree().process_frame
	var editor := studio.clip_editor
	check("the studio has one clip editor, closed", editor != null and not editor.is_open() and not editor.visible
			and studio.find_children("*", "ClipEditorSurface", true, false).size() == 1)
	check("it rides the timeline's stand", studio.mount.seats.has(editor.surface_id) and editor.get_parent() == studio.studio_set)
	studio.timeline.edit_asked.emit(2, 0)
	await get_tree().process_frame
	check("the timeline opens it", editor.is_open() and editor.target == [2, 0] and editor.visible)
	var top := editor.to_global(Vector3(0, ClipEditorSurface.TOP, 0)).y
	var lanes_bottom := studio.timeline.to_global(Vector3(0, studio.timeline._lanes_bottom, 0)).y
	check("it hangs under the timeline's lanes (%.3f < %.3f)" % [top, lanes_bottom], top < lanes_bottom)
	# Its board on the floor, against every other piece's footprint.
	var ends := [editor.to_global(Vector3(-ClipEditorSurface.WIDE * 0.5, 0, -0.02)), editor.to_global(Vector3(ClipEditorSurface.WIDE * 0.5, 0, 0.005))]
	var nearest := INF
	var near_what := ""
	for piece in studio.floor_plan.pieces:
		if piece == studio.timeline_stand or not piece.visible or not piece.has_method("footprint_at"):
			continue
		var print_of: Dictionary = piece.footprint_at(Vector2(piece.global_position.x, piece.global_position.z), piece.global_rotation.y)
		for k in 41:
			var p: Vector3 = (ends[0] as Vector3).lerp(ends[1], k / 40.0)
			var local := Trolley._floor_rotate(Vector2(p.x, p.z) - (print_of["c"] as Vector2), -float(print_of["a"]))
			var h: Vector2 = print_of["h"]
			var d := Vector2(maxf(absf(local.x) - h.x, 0.0), maxf(absf(local.y) - h.y, 0.0)).length()
			if d < nearest:
				nearest = d
				near_what = piece.name
	check("its board is 0.6 m clear of the room's other pieces (%.2f m from %s)" % [nearest, near_what], nearest >= 0.6)
	# The seat's camera through a 16:9 monitor (the suite's own window is a 64-pixel square).
	var cam := studio.get_viewport().get_camera_3d()
	var tall := tan(deg_to_rad(cam.fov) * 0.5) if cam != null else 0.0
	var seen := cam != null
	var worst := Vector2.ZERO
	for c in [Vector2(-1, -1), Vector2(1, -1), Vector2(-1, 1), Vector2(1, 1)]:
		var corner := editor.to_global(Vector3(c.x * ClipEditorSurface.WIDE * 0.5, ClipEditorSurface.TOP if c.y > 0 else ClipEditorSurface.BOTTOM, 0))
		var p := cam.global_transform.affine_inverse() * corner if cam != null else Vector3.ZERO
		var across := Vector2(absf(p.x) / maxf(-p.z, 0.0001) / (tall * 16.0 / 9.0), absf(p.y) / maxf(-p.z, 0.0001) / tall)
		worst = Vector2(maxf(worst.x, across.x), maxf(worst.y, across.y))
		if p.z >= 0.0 or across.x > 1.0 or across.y > 1.0:
			seen = false
	check("from the seat, on a 16:9 monitor, the whole of it is in view (to %.0f%% of the half width, %.0f%% of the half height)"
			% [worst.x * 100.0, worst.y * 100.0], seen)
	studio.free()
	Session.layout = saved_layout


func _test_a_locked_item_stays_put_on_the_timeline() -> void:
	_offline()
	var s := DAW.state
	DAW.transport_stop()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	timeline.set_view(0.0, s.bar_to_seconds(41.0))
	var hand := FakeHand.new()
	add_child(hand)
	var lanes: TimelineLanes = timeline._lanes
	var at := func(track_index: int, bar: float) -> Vector3:
		var i := s.track_indices().find(track_index)
		return timeline.to_global(Vector3(timeline._x_for(s.bar_to_seconds(bar)),
				timeline._lane_y[i], lanes.position.z))
	lanes.grab_begin(hand, at.call(2, 12.0))
	lanes.grab_end(hand)
	var page: TimelineItemPage = timeline.item_page
	check("the item's page has a lock token, a mark and no word", page.lock != null and page.lock.glyph == &"lock"
			and page.lock.available and not page.lock.lit)
	page.lock.pressed.emit()
	check("pressed, the item is locked and the token lit", s.item(2, 0).locked and page.lock.lit)
	check("its shape's rails and keys are out of reach", not page.gain.available and not page.fade_in.available
			and not page.normalise.available and page.mute.available)
	timeline._process(0.0)
	var strips := timeline.get_node_or_null("ItemStrips") as MeshBank
	check("and its thread is drawn white, pinned", strips != null and strips.colour_of(0).b > 1.2)
	var was: float = s.item(2, 0).start
	lanes.grab_begin(hand, at.call(2, 12.0))
	lanes.grab_move(hand, at.call(2, 20.0))
	lanes.grab_end(hand)
	check("dragged, it stays where it was (%.2f)" % s.item(2, 0).start, is_equal_approx(s.item(2, 0).start, was)
			and s.item(2, 0).selected)
	page.lock.pressed.emit()
	check("pressed again, it is free", not s.item(2, 0).locked and page.gain.available)
	DAW.undo()
	DAW.undo()
	DAW.clear_item_selection()
	timeline.free()
	hand.free()


func _test_a_ripple_delete_closes_the_gap() -> void:
	_offline()
	var s := DAW.state
	var lane := 2
	var items: Array = s.track(lane).items
	check("Kick has at least three items to ripple", items.size() >= 3)
	if items.size() < 3:
		return
	var starts: Array = items.map(func(it): return it.start)
	var gone: MixState.ItemState = items[0]
	var gone_length := gone.length
	var other_lane := 3
	var other_starts: Array = s.track(other_lane).items.map(func(it): return it.start)
	var depth := maxi(s.undo_depth, 0)
	DAW.select_item(lane, 0, false)
	DAW.ripple_delete_selected()
	var now: Array = s.track(lane).items
	check("the selected item is gone (%d -> %d)" % [starts.size(), now.size()], now.size() == starts.size() - 1)
	var moved_back := true
	for k in now.size():
		moved_back = moved_back and is_equal_approx(now[k].start, maxf(float(starts[k + 1]) - gone_length, 0.0))
	check("and everything after it on its track moved back by its length", moved_back)
	check("other tracks are untouched", s.track(other_lane).items.map(func(it): return it.start) == other_starts)
	check("one step to undo", s.undo_depth - depth == 1)
	DAW.undo()
	check("undo puts it back where it was", s.track(lane).items.map(func(it): return it.start) == starts)
	# A locked item after the gap stays where it is; a locked selected item is not deleted.
	DAW.set_item_locked(lane, 2, true)
	DAW.select_item(lane, 0, false)
	DAW.ripple_delete_selected()
	var pinned := s.track(lane).items.filter(func(it): return it.locked)
	check("a locked item later on its track does not move", pinned.size() == 1
			and is_equal_approx(pinned[0].start, float(starts[2])))
	DAW.undo()
	DAW.select_item(lane, 2, false)
	DAW.ripple_delete_selected()
	check("and a locked one selected is not deleted, nor is it history",
			s.track(lane).items.size() == starts.size() and s.track(lane).items[2].locked)
	DAW.set_item_locked(lane, 2, false)
	DAW.clear_item_selection()
	DAW.select_item(lane, 1, false)
	DAW.apply_intent(&"ripple_delete_selected", [])
	check("a guest may ask for one", &"ripple_delete_selected" in DAW.COMMANDS
			and s.track(lane).items.size() == starts.size() - 1)
	DAW.undo()
	DAW.clear_item_selection()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var key: GlyphKey = timeline._ripple_key
	check("its token is on the tools, dark with nothing selected", key != null and key in timeline.deck.tools
			and key.glyph == &"ripple_delete" and not key.lit)
	DAW.select_item(lane, 0, false)
	check("and lit with a selection", key.lit)
	key.pressed.emit()
	check("pressed, it ripples (%d of %d, %d selected)" % [s.track(lane).items.size(), starts.size(),
			s.selected_items().size()], s.track(lane).items.size() == starts.size() - 1)
	DAW.undo()
	DAW.clear_item_selection()
	timeline.free()


func _test_ripple_editing_carries_what_follows() -> void:
	_offline()
	var s := DAW.state
	var lane := 2
	var items: Array = s.track(lane).items
	check("Kick has at least three items to ripple", items.size() >= 3)
	if items.size() < 3:
		return
	var starts: Array = items.map(func(it): return it.start)
	var other_starts: Array = s.track(3).items.map(func(it): return it.start)
	var depth := maxi(s.undo_depth, 0)
	# The second item along by two seconds: it, and everything from where it was on, by two.
	DAW.ripple_move_item(lane, 1, float(starts[1]) + 2.0)
	var moved := true
	for k in starts.size():
		var want := float(starts[k]) + (2.0 if float(starts[k]) >= float(starts[1]) else 0.0)
		moved = moved and is_equal_approx(s.track(lane).items[k].start, want)
	check("a ripple move takes the item and what follows by as much, and nothing before it", moved)
	check("other tracks are untouched", s.track(3).items.map(func(it): return it.start) == other_starts)
	check("one step to undo", s.undo_depth - depth == 1)
	DAW.undo()
	check("undo puts them all back", s.track(lane).items.map(func(it): return it.start) == starts)
	# A locked item later on the track stays; a locked item itself does not move at all.
	DAW.set_item_locked(lane, 2, true)
	DAW.ripple_move_item(lane, 1, float(starts[1]) + 1.0)
	check("a locked item later on the track stays", is_equal_approx(s.track(lane).items[2].start, float(starts[2]))
			and is_equal_approx(s.track(lane).items[1].start, float(starts[1]) + 1.0))
	DAW.undo()
	var before_depth := s.undo_depth
	DAW.ripple_move_item(lane, 2, float(starts[2]) + 1.0)
	check("and a locked item refuses to ripple", is_equal_approx(s.track(lane).items[2].start, float(starts[2]))
			and s.undo_depth == before_depth)
	DAW.set_item_locked(lane, 2, false)
	# Trimmed a second shorter at its end: what follows comes a second earlier.
	var first: MixState.ItemState = s.track(lane).items[0]
	var end := first.end()
	DAW.ripple_trim_item(lane, 0, first.start, end - 1.0)
	var trimmed := true
	for k in range(1, starts.size()):
		var want := float(starts[k]) - (1.0 if float(starts[k]) >= end - 0.000001 else 0.0)
		trimmed = trimmed and is_equal_approx(s.track(lane).items[k].start, maxf(want, 0.0))
	check("a ripple trim moves what follows by as far as the end moved", trimmed
			and is_equal_approx(s.track(lane).items[0].end(), end - 1.0))
	DAW.undo()
	check("undone in one", s.track(lane).items.map(func(it): return it.start) == starts)
	var flat := s.undo_depth
	DAW.ripple_move_item(lane, 1, float(starts[1]))
	check("a ripple that moves nothing is not history", s.undo_depth == flat)
	DAW.apply_intent(&"ripple_move_item", [lane, 1, float(starts[1]) + 0.5])
	check("a guest may ask for one", is_equal_approx(s.track(lane).items[1].start, float(starts[1]) + 0.5))
	DAW.undo()
	DAW.apply_intent(&"ripple_trim_item", [lane, 1, "x"])
	check("a malformed one is refused", s.track(lane).items.map(func(it): return it.start) == starts)

	var timeline := TimelineSurface.new()
	add_child(timeline)
	timeline._process(0.0)
	var key: GlyphKey = timeline._ripple_mode_key
	check("its token is on the tools, off to begin with", key != null and key in timeline.deck.tools
			and key.glyph == &"ripple" and not timeline.ripple_edit and not key.lit)
	key.pressed.emit()
	check("pressed, ripple editing is on and the token lit", timeline.ripple_edit and key.lit)
	# A drag along the lane, as the hand lets go of it.
	var lanes: TimelineLanes = timeline._lanes
	lanes._hit = [lane, 1]
	lanes._dragged = true
	lanes._target_start = float(starts[1]) + 2.0
	lanes._target_track = -1
	lanes._finish_grab()
	check("a dragged item ripples while it is on", is_equal_approx(s.track(lane).items[2].start, float(starts[2]) + 2.0))
	DAW.undo()
	key.pressed.emit()
	lanes._hit = [lane, 1]
	lanes._dragged = true
	lanes._target_start = float(starts[1]) + 2.0
	lanes._target_track = -1
	lanes._finish_grab()
	check("and moves alone with it off", not timeline.ripple_edit
			and is_equal_approx(s.track(lane).items[2].start, float(starts[2]))
			and is_equal_approx(s.track(lane).items[1].start, float(starts[1]) + 2.0))
	DAW.undo()
	DAW.clear_item_selection()
	timeline.free()


func _test_the_host_keeps_an_autosave() -> void:
	var backend := _offline()
	backend.project_path = ""
	backend.project_title = "Suite Autosave"
	var copy := ProjectSettings.globalize_path(backend.autosave_path())
	DirAccess.remove_absolute(copy)
	check("the copy is kept by the project's name, apart from its own file (%s)" % backend.autosave_path(),
			backend.autosave_path().begins_with(OfflineBackend.AUTOSAVE_DIR) and backend.autosave_path().ends_with("Suite Autosave.dawproject"))
	backend._tick_autosave()
	check("nothing unsaved, nothing kept", not FileAccess.file_exists(copy) and backend.autosaved_at_msec < 0)
	OfflineBackend.autosave_every = 0.001
	DAW.set_track_volume(3, 0.3)
	check("an edit leaves work unsaved", DAW.has_unsaved_changes() and backend.needs_autosave())
	backend._tick_autosave()
	check("the clock starts at the first unsaved change, and nothing is written yet", not FileAccess.file_exists(copy))
	OS.delay_msec(5)
	DAW.transport_play()
	backend._tick_autosave()
	check("held while the transport runs", not FileAccess.file_exists(copy))
	DAW.transport_stop()
	backend._tick_autosave()
	check("kept once it rests", FileAccess.file_exists(copy) and backend.autosaved_at_msec >= 0)
	check("and the project is still where it was, with its changes still unsaved",
			backend.project_path == "" and DAW.has_unsaved_changes() and not backend.needs_autosave())
	DirAccess.remove_absolute(copy)
	OS.delay_msec(5)
	backend._tick_autosave()
	backend._tick_autosave()
	check("nothing new since, nothing written again", not FileAccess.file_exists(copy))
	DAW.set_track_volume(3, 0.5)
	backend._tick_autosave()
	OS.delay_msec(5)
	backend._tick_autosave()
	check("a further change is kept in its turn", FileAccess.file_exists(copy))
	var reopened := OfflineBackend.new()
	reopened.state = MixState.new()
	add_child(reopened)
	var refused := ProjectFiles.open(reopened, backend.autosave_path())
	check("the copy opens, with the work in it (%s)" % [refused], refused.is_empty()
			and reopened.state.track(3) != null and is_equal_approx(reopened.state.track(3).volume, 0.5))
	reopened.free()
	var timeline := TimelineSurface.new()
	add_child(timeline)
	check("the save token's card says when (%s)" % timeline._save_key.describe_value.call(0.0),
			timeline._save_key.describe_value.call(0.0).contains("copy kept just now"))
	timeline.free()
	DAW.save_project_as("user://suite_autosave/own.dawproject")
	backend._tick_autosave()
	check("a real save leaves nothing for it to do", not DAW.has_unsaved_changes() and not backend.needs_autosave())
	OfflineBackend.autosave_every = 0.0
	DirAccess.remove_absolute(copy)


const GRAPH_OUT := "dawlings · mix:output_FL\ndawlings · mix:output_FR\nMic:capture_1\nMidi-Bridge:Midi Through: Port-0 (capture)\n"
const GRAPH_IN := "alsa_output.usb-Scarlett.pro-output-0:playback_AUX0\nalsa_output.usb-Scarlett.pro-output-0:playback_AUX1\nRecorder:input_1\n"
const GRAPH_LINKS := "dawlings · mix:output_FL\n  |-> alsa_output.usb-Scarlett.pro-output-0:playback_AUX0\ndawlings · mix:output_FR\n  |-> alsa_output.usb-Scarlett.pro-output-0:playback_AUX1\nalsa_output.usb-Scarlett.pro-output-0:playback_AUX0\n  |<- dawlings · mix:output_FL\nMic:capture_1\n  |-> Recorder:input_1\n"


func _test_the_audio_graph_is_read_and_drawn() -> void:
	var g := PipeGraph.parse(GRAPH_OUT, GRAPH_IN, GRAPH_LINKS)
	check("every node with a port is read (%d)" % g.nodes.size(), g.nodes.size() == 5)
	check("a node's output ports and input ports are kept apart", g.nodes["dawlings · mix"]["outputs"].size() == 2
			and g.nodes["dawlings · mix"]["inputs"].is_empty() and g.nodes["Recorder"]["inputs"].size() == 1)
	check("a port name with spaces and colons stays whole", g.nodes["Midi-Bridge"]["outputs"][0] == "Midi-Bridge:Midi Through: Port-0 (capture)")
	check("each link once, though both ends list it (%d)" % g.links.size(), g.links.size() == 3
			and g.is_linked("dawlings · mix:output_FL", "alsa_output.usb-Scarlett.pro-output-0:playback_AUX0")
			and not g.is_linked("Mic:capture_1", "alsa_output.usb-Scarlett.pro-output-0:playback_AUX0"))
	check("a node and its port's label come off the name", PipeGraph.node_of("Mic:capture_1") == "Mic" and PipeGraph.label_of("Mic:capture_1") == "capture_1")
	check("a device's name is made short", PipeGraph.short_name("alsa_output.usb-Scarlett.pro-output-0") == "usb-Scarlett.pro-output-0"
			and PipeGraph.short_name("x".repeat(60)).length() == 26)
	check("nodes in use come first", g.nodes_by_use()[g.nodes_by_use().size() - 1] in ["Midi-Bridge"]
			and PipeGraph.parse(GRAPH_OUT, GRAPH_IN, GRAPH_LINKS).signature() == g.signature())

	var dir := OS.get_temp_dir().path_join("suite_pwlink")
	DirAccess.make_dir_recursive_absolute(dir)
	var tool := dir.path_join("pw-link")
	var log := dir.path_join("calls.txt")
	var f := FileAccess.open(tool, FileAccess.WRITE)
	f.store_string("#!/bin/sh\ncase \"$1\" in\n-o) printf '%s' '" + GRAPH_OUT + "';;\n-i) printf '%s' '" + GRAPH_IN + "';;\n-l) printf '%s' '" + GRAPH_LINKS + "';;\n*) echo \"$@\" >> " + log + ";;\nesac\n")
	f.close()
	OS.execute("chmod", ["+x", tool])
	var fetched := PipeGraph.fetch(tool)
	check("the machine's graph is asked for and read", fetched.nodes.size() == 5 and fetched.links.size() == 3 and fetched.error == "")
	check("a tool that is not there leaves an error, not a crash", not PipeGraph.fetch(dir.path_join("nothing")).error.is_empty())
	check("a patch is made and taken out by the tool", PipeGraph.link("a:out", "b:in", tool) and PipeGraph.unlink("a:out", "b:in", tool))
	check("as `pw-link out in` and `pw-link -d out in`", FileAccess.get_file_as_string(log) == "a:out b:in\n-d a:out b:in\n")

	var wall := PatchWallSurface.new()
	wall.follow = false
	add_child(wall)
	wall.show_graph(fetched)
	wall._process(0.0)
	var m := wall.matrix
	check("the wall is a matrix: each node's outputs down it, its inputs across (%d x %d, %d links)" % [
			m.row_count(), m.col_count(), wall.cables], m.row_count() == 3 + 4 and m.col_count() == 2 + 3 and wall.cables == 3)
	check("it names itself for the layout", wall.surface_id == &"patch_wall" and wall.surface_kind == &"patchwall")
	check("and keeps its size, whatever the graph", is_equal_approx(wall.height, PatchWallSurface.HEIGHT))
	wall.tool = tool
	var mix_out := "dawlings · mix:output_FL"
	var aux0 := "alsa_output.usb-Scarlett.pro-output-0:playback_AUX0"
	var group_row := m.row_line(0)
	check("a node heads its ports, by name, with how many (%s)" % [group_row], group_row.get("group", false)
			and group_row["name"] == "dawlings · mix" and int(group_row["count"]) == 2)
	check("every port is a crossing to press", m.pin_for(mix_out, aux0) != null and m.pin_for("Mic:capture_1", "Recorder:input_1") != null)
	check("a link is a seated pin", m.pin_for(mix_out, aux0).cell().get("on", false)
			and not m.pin_for(mix_out, "Recorder:input_1").cell().get("on", false))
	check("a pin says what it joins (%s)" % m.pin_for(mix_out, aux0).title(), m.pin_for(mix_out, aux0).title().contains("OUTPUT_FL")
			and m.pin_for(mix_out, aux0).title().contains("PLAYBACK_AUX0") and m.pin_for(mix_out, aux0).readout().begins_with("patched"))
	check("a port's header counts its links (%s)" % m.line_for(mix_out, true).readout(), m.line_for(mix_out, true).readout().begins_with("patched to 1"))
	_press(m.pin_for(mix_out, "Recorder:input_1"))
	check("a press on an empty crossing patches the two", FileAccess.get_file_as_string(log).ends_with("\ndawlings · mix:output_FL Recorder:input_1\n")
			and wall.status.begins_with("patched"))
	check("and the foot says so (%s)" % m.status_words(), m.status_words().begins_with("patched"))
	wall._process(0.0)
	_press(m.pin_for(mix_out, aux0))
	check("a press on a seated pin cuts that link", FileAccess.get_file_as_string(log).ends_with("\n-d dawlings · mix:output_FL " + aux0 + "\n")
			and wall.status.begins_with("cut"))
	wall._process(0.0)
	var words := ""
	for child in wall.get_children():
		if child is Label3D and (child as Label3D).text.contains("links"):
			words = (child as Label3D).text
	check("the footer says what the last press did (%s)" % words, words.contains("cut"))
	# Folded and opened.
	var before := m.row_count()
	_press(m.line_for("@dawlings · mix", true))
	check("pressing a node's name folds its ports away", m.row_count() == before - 2 and m.is_collapsed("@dawlings · mix")
			and m.pin_for(mix_out, aux0) == null)
	var folded := m.line_for("@dawlings · mix", true)
	check("and its name says how many it holds (%s)" % m._row_text[m._row_lines.find(folded)].text,
			m._row_text[m._row_lines.find(folded)].text.ends_with("(2)"))
	var sum := m.pin_for("@dawlings · mix", "@alsa_output.usb-Scarlett.pro-output-0")
	check("a crossing with a folded node counts its links (%s)" % sum.readout(), sum.readout() == "2 links")
	_press(sum)
	check("and pressing it opens the node", m.row_count() == before and not m.is_collapsed("@dawlings · mix"))
	var calls := FileAccess.get_file_as_string(log)
	_press(m.pin_for("@Mic", "Recorder:input_1"))
	check("a node's open crossing patches nothing", FileAccess.get_file_as_string(log) == calls)
	wall._process(0.0)
	var count := wall.get_child_count()
	wall.show_graph(PipeGraph.parse(GRAPH_OUT, GRAPH_IN, GRAPH_LINKS))
	wall._process(0.0)
	check("the same graph is not drawn again", wall.get_child_count() == count)
	var broken := PipeGraph.new()
	broken.error = "no audio graph"
	wall.show_graph(broken)
	wall._process(0.0)
	check("without a graph it says so and shows no pins", wall.cables == 0 and not m.visible and m.row_count() == 0)
	wall.free()

	# However big the machine's graph, every port is somewhere a hand can reach: the matrix
	# scrolls, and nothing is counted at a foot and left out.
	var big_out := ""
	var big_in := ""
	for n in 40:
		for k in 4:
			big_out += "src%d:out_%d\n" % [n, k]
			big_in += "dst%d:in_%d\n" % [n, k]
	for k in 30:
		big_out += "huge:out_%d\n" % k
	var big := PatchWallSurface.new()
	big.follow = false
	add_child(big)
	big.show_graph(PipeGraph.parse(big_out, big_in, "src0:out_0\n   |-> dst0:in_0\nsrc39:out_3\n   |-> dst39:in_3\n"))
	big._process(0.0)
	var bm := big.matrix
	check("190 outputs under 41 nodes, 160 inputs under 40 (%d x %d)" % [bm.row_count(), bm.col_count()],
			bm.row_count() == 190 + 41 and bm.col_count() == 160 + 40)
	check("shown at a readable size, the rest a scroll away (%d x %d)" % [bm.shown_rows(), bm.shown_cols()],
			bm.shown_rows() >= 10 and bm.shown_cols() >= 20 and bm.cell_size().y >= bm.row_pitch.x - 0.0001)
	var seen_rows := {}
	var seen_cols := {}
	var top := 0
	while top < bm.row_count():
		bm.scroll_to(top, 0)
		for line in bm._row_lines:
			if line.index >= 0:
				seen_rows[line.line()["key"]] = true
		top += bm.shown_rows()
	var left := 0
	while left < bm.col_count():
		bm.scroll_to(0, left)
		for line in bm._col_lines:
			if line.index >= 0:
				seen_cols[line.line()["key"]] = true
		left += bm.shown_cols()
	check("scrolling reaches every output and every input (%d of %d, %d of %d)" % [seen_rows.size(), bm.row_count(),
			seen_cols.size(), bm.col_count()], seen_rows.size() == bm.row_count() and seen_cols.size() == bm.col_count())
	bm.scroll_to(1000, 1000)
	check("the far corner is a crossing to press", bm.pin_for(bm.row_line(bm.row_count() - 1)["key"],
			bm.col_line(bm.col_count() - 1)["key"]) != null)
	var texts := big.find_children("*", "Label3D", true, false).map(func(l): return (l as Label3D).text)
	check("and nothing is left counted at a foot (%s)" % [texts.filter(func(t): return str(t).contains("more") or str(t).contains("page"))],
			not texts.any(func(t): return str(t).contains("more") or str(t).contains("other page")))
	check("the foot says where the window is (%s)" % bm.position_words(), bm.position_words().begins_with("ROWS ")
			and bm.position_words().contains("OF 231"))
	big.free()
	DirAccess.remove_absolute(log)
	DirAccess.remove_absolute(tool)


