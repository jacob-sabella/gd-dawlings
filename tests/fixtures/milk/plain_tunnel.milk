per_frame_init_1=q8 = 3; spin = 0;
per_frame_1=wave_r = 0.5 + 0.5*sin(time*1.13);
per_frame_2=wave_g = 0.5 + 0.5*sin(time*0.97);
per_frame_3=zoom = zoom + 0.02*bass_att; spin = spin + 0.01*treb;
per_frame_4=rot = rot + 0.02*sin(spin); q1 = bass; q2 = q8 * 0.1;
per_pixel_1=zoom = zoom + rad*0.04*q1;
per_pixel_2=rot = rot + q2*sin(ang*3 + time)*0.1;
per_pixel_3=dx = if(above(x, 0.5), 0.002, -0.002);
