# noray's configuration for dawlings (https://github.com/foxssake/noray, pinned in pin.env).
# Read by the systemd user unit (EnvironmentFile=) on the server, and by tools/noray_local.sh,
# which overrides the listen addresses for a machine's own loopback.
#
# Codes: six characters from the alphabet a session code already uses -- nothing that can be
# misread across a room or misheard on a call (no 0/O, 1/I/L, 5/S, 2/Z, 8/B). 25^6 is 244
# million: a code is not a secret (docs/multiplayer.md), only hard to land on by accident.
NORAY_OID_LENGTH=6
NORAY_OID_CHARSET=ACDEFGHJKMNPQRTUVWXY34679
NORAY_PID_LENGTH=64
NORAY_PID_CHARSET=useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict
NORAY_ENABLE_WORDS_OID=false

# Clients register and ask for connections here (TCP).
NORAY_SOCKET_HOST=0.0.0.0
NORAY_SOCKET_PORT=8890
# Prometheus metrics. Loopback only: nothing outside needs them, and Caddy cannot reach them
# from rootless docker anyway (deploy/noray/README in docs/multiplayer.md).
NORAY_HTTP_HOST=127.0.0.1
NORAY_HTTP_PORT=8891

# The UDP registrar: where each game socket says its private id, so noray learns its public
# address. Must see the client's real address -- why this does not run in rootless docker.
NORAY_UDP_REGISTRAR_PORT=8809

# Relays: one port per registered address that is relayed (a host and each of its relayed guests).
# 64 ports is 32 relayed sessions of one guest, plenty for a band app; each costs one socket.
NORAY_UDP_RELAY_PORTS=49152-49215
NORAY_UDP_RELAY_TIMEOUT=30s
NORAY_UDP_RELAY_CLEANUP_INTERVAL=30s

# Bandwidth. The mix is ~190 KiB/s to each listening guest, and a host's relay carries it to every
# relayed guest at once, so noray's default (128kb/s a relay) would cut the mix to pieces. 1Mb a
# relay is a host and four relayed listeners. The global cap keeps a busy night from eating the
# VPS's whole uplink: 8 MiB/s is 64 Mbit/s.
NORAY_UDP_RELAY_MAX_INDIVIDUAL_TRAFFIC=1Mb
NORAY_UDP_RELAY_MAX_GLOBAL_TRAFFIC=8Mb
NORAY_UDP_RELAY_TRAFFIC_INTERVAL=100ms
# A long session is a long evening; noray's default is 4 hours.
NORAY_UDP_RELAY_MAX_LIFETIME_DURATION=12hr
NORAY_UDP_RELAY_MAX_LIFETIME_TRAFFIC=40Gb

NORAY_LOGLEVEL=info
